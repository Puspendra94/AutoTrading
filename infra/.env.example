# Copy to infra/.env. Never commit the real file.
#
#   cp .env.example .env
#
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB and REDIS_PASSWORD must MATCH the values in the
# root .env — that is how the apps authenticate to these services.

POSTGRES_USER=postgres
# REQUIRED — compose refuses to start without it, so a public host can never come up with a
# guessable default.
#
# IMPORTANT: this only takes effect when the data volume is FIRST created. On a machine that
# already has an initialised infra_postgres_data volume, put the EXISTING password here (the
# original default was `postgres`); changing this value does not change the database's password.
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Empty = no authentication, which is how local development has always run.
# Set a strong value on any deployed host — Redis has no auth by default.
#   openssl rand -base64 32
REDIS_PASSWORD=

# --- Exposure ---------------------------------------------------------------
# 127.0.0.1 keeps these off the internet; the apps reach them by service name over the
# `algo_trading` network, so nothing here needs to be publicly reachable.
BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5433
REDIS_PORT=55000

# --- Postgres tuning (raise on a larger host) --------------------------------
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB

# --- Optional tooling, only with `--profile tools` ---------------------------
REDIS_COMMANDER_PORT=8081
