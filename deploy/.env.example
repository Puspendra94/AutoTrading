# Copy to deploy/.env on the host and fill in. Never commit the real file.
#
#   cp .env.example .env
#
# Generate the two passwords rather than inventing them:
#   openssl rand -base64 32

# --- Postgres / TimescaleDB -------------------------------------------------
POSTGRES_USER=postgres
# REQUIRED. Compose refuses to start without it — deliberately, so a public host can never
# come up with a guessable default.
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
# Loopback-only publish, for SSH tunnelling. Not exposed to the internet.
POSTGRES_PORT=5433

# --- Redis ------------------------------------------------------------------
# REQUIRED. Redis ships with no authentication at all.
REDIS_PASSWORD=
REDIS_PORT=55000

# --- Optional tooling (only with `--profile tools`) --------------------------
REDIS_COMMANDER_PORT=8081
