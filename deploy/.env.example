# Copy to deploy/.env on the host and fill in. Never commit the real file.
#
#   cp .env.example .env
#
# One file configures both stacks. Generate every secret rather than inventing one:
#   openssl rand -base64 32

# =============================================================================
# Infra (docker-compose.infra.yml)
# =============================================================================
POSTGRES_USER=postgres
# REQUIRED. Compose refuses to start without it — deliberately, so a public host can never come
# up with a guessable default.
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
# Loopback-only publish, for SSH tunnelling. Not reachable from the internet.
POSTGRES_PORT=5433

# REQUIRED. Redis ships with no authentication at all.
REDIS_PASSWORD=
REDIS_PORT=55000

# Only used with `--profile tools`.
REDIS_COMMANDER_PORT=8081

# =============================================================================
# Apps (docker-compose.apps.yml)
# =============================================================================
DATABASE_SCHEMA=Algo_Trading

# REQUIRED. Anyone holding this can mint a session — make it long and random.
JWT_SECRET=
# REQUIRED. Shared secret guarding the backend's /internal/jobs/* endpoints; the worker sends it.
INTERNAL_API_KEY=

# REQUIRED for the worker. Without it the decision loop cannot call the model.
DEEPSEEK_API_KEY=
LLM_MODELS=deepseek:deepseek-v4-flash

# --- What the worker actually does -------------------------------------------
# 'pattern' = the feature-engine + LLM brain. 'strategy' = the retired generated-strategy engine.
TRADING_BRAIN=pattern
# The separate switch from observing to TRADING. Leave false for the first run: the worker will
# stream, backfill and record decisions without opening a single position. Flip it once you have
# watched a few bars land and are happy.
PATTERN_DECISIONS_ENABLED=false
PATTERN_INTERVAL=15m
# First boot re-fetches the whole candle history from data.binance.vision (~4.7M rows for
# BTCUSDT 1m since 2017). Expect the first start to take a while.
BACKFILL_ON_START=true

# --- Dashboard exposure -------------------------------------------------------
# Loopback by default: the app has a login form and no TLS, so publishing it directly would put
# your password on the wire in cleartext. Reach it over an SSH tunnel:
#   ssh -L 4321:127.0.0.1:4321 user@host
# To expose it for real, put Caddy (automatic certificates) in front — do not set 0.0.0.0 here.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=4321
