# Copy to .env in the repo root. Never commit the real file.
#
#   cp .env.example .env
#
# This configures the APP stack (backend, frontend, worker). Infra has its own infra/.env.
# The database and Redis credentials must MATCH the ones there.

# --- Must match infra/.env ---------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
REDIS_PASSWORD=
DATABASE_SCHEMA=Algo_Trading

# --- Backend secrets (the only two its config validation requires) -----------
# Anyone holding JWT_SECRET can mint a session. Generate both:
#   openssl rand -base64 32
JWT_SECRET=
# Shared secret guarding the backend's /internal/jobs/* endpoints; the worker sends it.
INTERNAL_API_KEY=

# --- LLM ---------------------------------------------------------------------
# REQUIRED by the worker: without it the decision loop cannot call the model.
DEEPSEEK_API_KEY=
LLM_MODELS=deepseek:deepseek-v4-flash

# --- What the worker actually does -------------------------------------------
# 'pattern' = feature engine + LLM brain. 'strategy' = the retired generated-strategy engine.
TRADING_BRAIN=pattern
# The separate switch from OBSERVING to TRADING. Leave false for a first deploy: the worker will
# stream, backfill and record decisions without opening a single position. Flip it once you have
# watched a few heartbeat lines land, then restart the worker (nothing reloads .env by itself).
PATTERN_DECISIONS_ENABLED=false
PATTERN_INTERVAL=15m
# First boot re-fetches the whole candle history from data.binance.vision (~4.7M rows for
# BTCUSDT 1m since 2017), so expect a slow first start and do NOT dump/restore a database.
BACKFILL_ON_START=true

# --- Dashboard exposure ------------------------------------------------------
# Loopback by default: the app has a login form and no TLS, so publishing it directly would put
# your password on the wire in cleartext. Reach it over an SSH tunnel:
#   ssh -L 4321:127.0.0.1:4321 user@host
# To expose it for real, put Caddy (automatic certificates) in front — do not set 0.0.0.0 here.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=4321
