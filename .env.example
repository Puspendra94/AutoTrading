# Infrastructure Ports & Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5433
REDIS_PORT=55000
REDIS_COMMANDER_PORT=8081

# Application Environment
NODE_ENV=development
PORT=3000
WS_PORT=3001
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
JWT_EXPIRATION=7d

# Database Connection (Backend)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres
DATABASE_SCHEMA=Algo_Trading

# Redis Connection (Backend)
REDIS_HOST=localhost
REDIS_PORT=55000

# LLM Configuration
# Select provider: direct_api | bedrock
LLM_PROVIDER=direct_api
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Trading & Risk Configuration Defaults
DEFAULT_DAILY_LOSS_LIMIT_PCT=2.0
DEFAULT_MAX_CONCURRENT_POSITIONS=1
DEFAULT_PROBATION_SIZE_PCT=25.0
DEFAULT_PROBATION_TRADES_COUNT=10
