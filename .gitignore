# Dependencies
node_modules/
apps/*/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (Service-Level)
.env
infra/.env
apps/*/.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Downloaded cloud-provider credential exports (e.g. AWS "Access keys" CSV) —
# never belongs in the repo regardless of directory.
*accessKeys*.csv
*access-keys*.csv
*api-keys*.csv
*_keys.csv

# Build Outputs
dist/
build/
apps/*/dist/
apps/*/build/
.astro/

# Python worker
.venv/
apps/*/.venv/
__pycache__/
*.pyc
.pytest_cache/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database & Runtime Data
*.sqlite
*.db

# System & IDE Files
.DS_Store
.vscode/
.idea/

# Claude Code local settings (personal, per-machine)
.claude/settings.local.json
