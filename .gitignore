# Dependencies
node_modules/
apps/*/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (Service-Level)
.env
infra/.env
apps/*/.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Downloaded cloud-provider credential exports (e.g. AWS "Access keys" CSV) —
# never belongs in the repo regardless of directory.
*accessKeys*.csv
*access-keys*.csv
*api-keys*.csv
*_keys.csv

# Build Outputs
dist/
build/
apps/*/dist/
apps/*/build/
.astro/

# Python worker
.venv/
apps/*/.venv/
__pycache__/
*.pyc
.pytest_cache/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database & Runtime Data
*.sqlite
*.db

# System & IDE Files
.DS_Store
.vscode/
.idea/

# Generated lockfile — regenerated by `npm install`, intentionally not tracked.
package-lock.json

# NOTE: agent/LLM instructions are intentionally tracked so they travel with the repo:
#   .agents/ , .claude/ , skills-lock.json , and all *.md (CONVENTIONS.md, READMEs, etc.)
# Do not add ignore rules for those.
# Override the user's global ignore (~/.config/git/ignore) so the Claude Code settings
# are shared too. Heads-up: this file is rewritten as permissions are granted, so expect
# noisy diffs — drop this negation if that's unwanted.
!.claude/settings.local.json
