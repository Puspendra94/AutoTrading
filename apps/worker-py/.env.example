# Python worker config — shares the same Postgres/Timescale + Redis as the NestJS backend.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres
DATABASE_SCHEMA=Algo_Trading

REDIS_HOST=localhost
REDIS_PORT=55000

# Backend API + shared secret for triggering /internal/jobs/* (must match the backend's
# INTERNAL_API_KEY). In Docker this is http://backend:3009.
BACKEND_URL=http://localhost:3009
INTERNAL_API_KEY=change-me-internal-secret
BALANCE_SYNC_INTERVAL_MINUTES=5

# --- Archive backfill (change #7) ---
# Store one base interval (1m = the minimum Binance publishes); higher intervals are
# derived at query time via TimescaleDB time_bucket (worker/candles.py).
BACKFILL_SYMBOL=BTCUSDT
BASE_INTERVAL=1m
BACKFILL_INTERVALS=1m
# BTCUSDT spot history starts 2017-08. Narrow this for a quick smoke test (e.g. 2024-11).
BACKFILL_START=2017-08
# Backfill missing data on every startup (cheap — resumes from the last stored month).
BACKFILL_ON_START=true

LOG_LEVEL=INFO
