# Python worker environment. Every key here is read by worker/config.py (the worker's single
# config surface — nothing else calls os.getenv). Shares the same Postgres/Timescale + Redis
# as the NestJS backend. Copy to `apps/worker-py/.env` and fill in secrets.

# --- Database (same instance + Algo_Trading schema as the backend) ---
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres
DATABASE_SCHEMA=Algo_Trading

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=55000

# --- Backend API + scheduled-job dispatch ---
# BACKEND_URL: the worker triggers the former Node-worker jobs via the backend's guarded
# /internal/jobs/* endpoints. In Docker this is http://backend:3009.
BACKEND_URL=http://localhost:3009
# Must match the backend's INTERNAL_API_KEY.
INTERNAL_API_KEY=change-me-internal-secret
BALANCE_SYNC_INTERVAL_MINUTES=5
# How scheduled jobs reach the backend (Phase 2, see MIGRATION.md):
#   http  (default) = POST /internal/jobs/* synchronously (worker depends on backend).
#   redis           = publish the job name to jobs:trigger; backend consumes it async.
JOB_DISPATCH=http

# --- Binance public endpoints (no auth) ---
BINANCE_VISION_BASE=https://data.binance.vision
BINANCE_API_BASE=https://api.binance.com
BINANCE_WS_BASE=wss://stream.binance.com:9443

# --- Archive backfill ---
# Store one base interval (1m = the minimum Binance publishes); higher intervals are derived
# at query time via TimescaleDB time_bucket (worker/candles.py).
BACKFILL_SYMBOL=BTCUSDT
BASE_INTERVAL=1m
BACKFILL_INTERVALS=1m
# BTCUSDT spot history starts 2017-08. Narrow this for a quick smoke test (e.g. 2024-11).
BACKFILL_START=2017-08
# Backfill missing data on every startup (cheap — resumes from the last stored month).
BACKFILL_ON_START=true

# --- Live-ingestion pipeline (Phase 1, see MIGRATION.md) ---
# false (default) = worker does NOT stream (the backend still does). true = worker owns the
# kline stream and writes candles. Never enable this while the backend is still
# LIVE_STREAM_SOURCE=internal — that double-ingests every candle. Flip both together at cutover.
LIVE_STREAM_ENABLED=false

# --- Live trading loop ownership (Phase 3c-3) — the ONLY switch that moves real capital. ---
# true = worker runs mark-price/hard-exits/evaluate+execute on its own stream (requires
# LIVE_STREAM_ENABLED=true). When true, the backend MUST be set to LIVE_EXECUTION_SOURCE=worker
# so execution never runs in both places (double orders). Validate on testnet first.
WORKER_OWNS_EXECUTION=false
# Consecutive provider-API failures before the execution store trips the kill switch.
PROVIDER_API_FAILURE_THRESHOLD=5

# --- Strategy Supervisor (Phase 3a) — deterministic, no-AI guardrail monitor. ---
# Off by default (dark launch). When enabled it watches each LIVE strategy and asks the
# backend to regenerate on a trip, replacing the daily strategy-reevaluation trigger.
SUPERVISOR_ENABLED=false
SUPERVISOR_INTERVAL_MINUTES=5
SUPERVISOR_MIN_CLOSED_TRADES=5
SUPERVISOR_DIVERGENCE_PCT=30
SUPERVISOR_MAX_CONSECUTIVE_LOSSES=5
SUPERVISOR_MAX_DRAWDOWN_PCT=20
SUPERVISOR_MIN_WIN_RATE_PCT=30
SUPERVISOR_NOTIONAL_BASE=10000
# On a guardrail trip: false (default) publishes strategy:regenerate for the backend to run
# generation; true runs the ported generation in-process (keep false until validated).
SUPERVISOR_GENERATE_INLINE=false

# --- LLM (provider-agnostic fallback chain — mirrors the backend's LLM_MODELS). ---
# Comma-separated "provider:modelId" pairs (direct_api | bedrock | deepseek), tried in order.
LLM_MODELS=direct_api:claude-opus-4-8
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Only needed for 'bedrock' entries in LLM_MODELS.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEDROCK_API_KEY=

# --- Logging ---
LOG_LEVEL=INFO
