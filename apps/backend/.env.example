# Backend Application Environment
NODE_ENV=development
PORT=3009
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
JWT_EXPIRATION=7d

# Shared secret guarding the /internal/jobs/* endpoints the Python worker triggers on a
# schedule. Must match the worker's INTERNAL_API_KEY. Fails closed if unset.
INTERNAL_API_KEY=change-me-internal-secret

# Database Connection (PostgreSQL + TimescaleDB)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres
DATABASE_SCHEMA=Algo_Trading

# Redis Cache & PubSub Connection
REDIS_HOST=localhost
REDIS_PORT=55000

# LLM Configuration — provider-agnostic fallback chain (LangChain under the hood).
# Comma-separated "provider:modelId" pairs, tried in order; first success wins.
# provider is one of:
#   bedrock    - any Converse-API-compatible model (Anthropic, DeepSeek, gpt-oss,
#                MiniMax, etc.) via AWS. modelId must be the EXACT Converse-API
#                model ID (e.g. "anthropic.claude-sonnet-4-5-20250929-v1:0") —
#                copy it from `aws bedrock list-foundation-models` or the console.
#   direct_api - Anthropic's own API (ANTHROPIC_API_KEY)
#   deepseek   - DeepSeek's own API directly, not via Bedrock (DEEPSEEK_API_KEY),
#                modelId is e.g. "deepseek-chat" or "deepseek-reasoner"
# Example chain: LLM_MODELS=bedrock:anthropic.claude-sonnet-4-5-20250929-v1:0,deepseek:deepseek-chat,direct_api:claude-opus-4-8
LLM_MODELS=direct_api:claude-opus-4-8
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=

# Only needed for 'bedrock' entries in LLM_MODELS. Claude isn't in-region on every
# AWS region (notably NOT ap-south-1/Mumbai) — AWS_REGION is just which Bedrock
# endpoint to call, not where you physically are.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: AWS Bedrock long-term "API key" (bearer token) as an alternative to the
# access key/secret pair above — takes precedence when set.
AWS_BEDROCK_API_KEY=

# Trading & Risk Configuration Defaults
DEFAULT_DAILY_LOSS_LIMIT_PCT=2.0
DEFAULT_MAX_CONCURRENT_POSITIONS=1
DEFAULT_PROBATION_SIZE_PCT=25.0
DEFAULT_PROBATION_TRADES_COUNT=10
ALLOCATION_DIVERSIFICATION_CAP_PCT=40

# Background worker job intervals (apps/backend/src/worker.ts)
BALANCE_SYNC_INTERVAL_MINUTES=5

# Optional: Telegram push for Critical-tier alerts. Leave unset to skip — critical
# alerts still get recorded in the alerts table and pushed live over WebSocket.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
