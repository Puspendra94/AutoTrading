# Backend service environment. Every key here is read (and validated) by
# src/config/configuration.ts — that file is the single source of truth; nothing in
# src/ reads process.env directly. Copy this to `apps/backend/.env` and fill in secrets.

# --- Application ---
NODE_ENV=development
PORT=3009
# Base URL of the frontend, used to build password-reset links.
FRONTEND_URL=http://localhost:4321

# --- Auth (REQUIRED — the app fails fast at startup if either is unset) ---
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
JWT_EXPIRATION=7d

# Shared secret guarding the /internal/jobs/* endpoints the Python worker triggers on a
# schedule. Must match the worker's INTERNAL_API_KEY. REQUIRED (fails closed if unset).
INTERNAL_API_KEY=change-me-internal-secret

# --- Database (PostgreSQL + TimescaleDB) ---
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres
# The Algo_Trading schema is created and pinned by the TypeORM migrations, not read from
# env by the backend — this is here for parity with the worker/infra and documentation.
DATABASE_SCHEMA=Algo_Trading
# Set to true to log every TypeORM SQL query (off by default — keeps API logs readable).
TYPEORM_LOGGING=false

# --- Redis (cache + pub/sub) ---
REDIS_HOST=localhost
REDIS_PORT=55000

# --- Live-ingestion / execution ownership (see MIGRATION.md) ---
# LIVE_STREAM_SOURCE: internal (default) = backend owns the Binance WS in-process;
#                     redis = consume ticks the worker publishes to market:tick.
LIVE_STREAM_SOURCE=internal
# LIVE_EXECUTION_SOURCE: backend (default) = backend runs the live trading loop;
#                        worker = the Python worker owns execution (flip together with the
#                        worker's WORKER_OWNS_EXECUTION — never one alone).
LIVE_EXECUTION_SOURCE=backend
# In-process historical backfill pipeline. Enabled unless set to exactly 'false'.
HISTORICAL_BACKFILL_ENABLED=true

# --- Strategy generation timeframe ---
# Interval strategies are generated/backtested on. Only 1m candles are ingested; higher
# intervals are aggregated on the fly via TimescaleDB time_bucket. 1m trend-following is
# noise/fee-dominated and has no edge (empirically 0/216 EMA-crossover param combos clear the
# gate on 1m BTC). 1h is the default: enough trades for a reliable Sharpe and a reachable
# trade-count gate. Any '<n><m|h|d|w>' interval (e.g. 1h, 2h, 4h, 1d).
STRATEGY_EVAL_INTERVAL=1h
# How many aggregated bars of STRATEGY_EVAL_INTERVAL to backtest over (more = more trades /
# statistical significance, but reaches further back into older market regimes).
STRATEGY_EVAL_CANDLE_LIMIT=4000
# Note: the generation timeframe can also be chosen per run from the UI ("Generate New Strategy"),
# which overrides STRATEGY_EVAL_INTERVAL and is stored per strategy (strategies.eval_interval).

# Simulated starting equity for PAPER trading — used to compute paper P/L, ROI, and available
# balance on the dashboard. Real (live) balances always come from the exchange, not this.
PAPER_STARTING_BALANCE_USD=10000

# --- LLM — provider-agnostic fallback chain (LangChain under the hood). ---
# Comma-separated "provider:modelId" pairs, tried in order; first success wins.
# provider is one of:
#   bedrock    - any Converse-API-compatible model (Anthropic, DeepSeek, gpt-oss,
#                MiniMax, etc.) via AWS. modelId must be the EXACT Converse-API model ID
#                (e.g. "anthropic.claude-sonnet-4-5-20250929-v1:0") — copy it from
#                `aws bedrock list-foundation-models` or the console, don't guess it.
#   direct_api - Anthropic's own API (ANTHROPIC_API_KEY)
#   deepseek   - DeepSeek's own API directly, not via Bedrock (DEEPSEEK_API_KEY)
# Example chain: LLM_MODELS=bedrock:anthropic.claude-sonnet-4-5-20250929-v1:0,deepseek:deepseek-chat,direct_api:claude-opus-4-8
LLM_MODELS=direct_api:claude-opus-4-8
# Used only by the direct_api entries in LLM_MODELS.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Used only by the deepseek entries in LLM_MODELS.
DEEPSEEK_API_KEY=

# Only needed for 'bedrock' entries. Claude isn't in-region on every AWS region (notably
# NOT ap-south-1/Mumbai) — AWS_REGION is just which Bedrock endpoint to call.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional short-lived STS session token (for temporary credentials).
AWS_SESSION_TOKEN=
# Optional AWS Bedrock long-term "API key" (bearer token) as an alternative to the
# access key/secret pair above — takes precedence when set.
AWS_BEDROCK_API_KEY=

# --- Trading & Risk defaults (applied to new providers' risk limits) ---
DEFAULT_DAILY_LOSS_LIMIT_PCT=2.0
DEFAULT_MAX_CONCURRENT_POSITIONS=1
DEFAULT_PROBATION_SIZE_PCT=25.0
DEFAULT_PROBATION_TRADES_COUNT=10
ALLOCATION_DIVERSIFICATION_CAP_PCT=40
# Consecutive provider-API failures before the kill switch trips.
PROVIDER_API_FAILURE_THRESHOLD=5

# --- Optional: Telegram push for Critical-tier alerts. ---
# Leave unset to skip — critical alerts are still recorded in the alerts table and pushed
# live over WebSocket.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
