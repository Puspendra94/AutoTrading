# Backend Application Environment
NODE_ENV=development
PORT=3009
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
JWT_EXPIRATION=7d

# Database Connection (PostgreSQL + TimescaleDB)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres
DATABASE_SCHEMA=Algo_Trading

# Redis Cache & PubSub Connection
REDIS_HOST=localhost
REDIS_PORT=55000

# LLM Configuration (direct_api | bedrock)
LLM_PROVIDER=direct_api
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Trading & Risk Configuration Defaults
DEFAULT_DAILY_LOSS_LIMIT_PCT=2.0
DEFAULT_MAX_CONCURRENT_POSITIONS=1
DEFAULT_PROBATION_SIZE_PCT=25.0
DEFAULT_PROBATION_TRADES_COUNT=10
ALLOCATION_DIVERSIFICATION_CAP_PCT=40

# Background worker job intervals (apps/backend/src/worker.ts)
BALANCE_SYNC_INTERVAL_MINUTES=5

# Optional: Telegram push for Critical-tier alerts. Leave unset to skip — critical
# alerts still get recorded in the alerts table and pushed live over WebSocket.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
