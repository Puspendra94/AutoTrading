---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'AI Algorithmic Trading Platform' } = Astro.props;

const navItems = [
  { href: '/', label: 'Dashboard' },
  { href: '/providers', label: 'Providers' },
  { href: '/strategies', label: 'Strategy Engine' },
  { href: '/alerts', label: 'Alerts' },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="AI-assisted multi-provider algorithmic trading platform" />
    <script is:inline>
      // Applied before first paint to avoid a flash of the wrong theme.
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          document.documentElement.setAttribute('data-theme', stored === 'light' ? 'light' : 'dark');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    <div class="app-container">
      <header class="app-header">
        <div class="header-left">
          <div class="logo">
            <span class="logo-icon">⚡</span>
            <span class="logo-text">AutoTrade <span class="logo-badge">AI</span></span>
          </div>
        </div>
        <nav class="app-nav">
          {navItems.map((item) => (
            <a
              href={item.href}
              class={`nav-item ${currentPath === item.href ? 'active' : ''}`}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="header-right">
          <button id="themeToggleBtn" class="theme-toggle-btn" type="button" title="Toggle theme" aria-label="Toggle theme">🌙</button>
          <div class="system-status">
            <span class="status-dot"></span>
            <span class="status-text">Risk Gate: Active</span>
          </div>
          <button id="logoutBtn" class="btn btn-outline" type="button">Logout</button>
        </div>
      </header>

      <main class="main-content">
        <slot />
      </main>
    </div>

    <style>
      .app-container {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      .app-header {
        height: 64px;
        background: rgba(13, 18, 30, 0.8);
        backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1.5rem;
        position: sticky;
        top: 0;
        z-index: 100;
      }
      :root[data-theme='light'] .app-header {
        background: rgba(255, 255, 255, 0.8);
      }
      .header-left {
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        font-size: 1.15rem;
      }
      .logo-icon {
        font-size: 1.25rem;
      }
      .logo-badge {
        font-size: 0.65rem;
        background: linear-gradient(135deg, var(--accent-cyan), var(--accent-violet));
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        color: #fff;
        text-transform: uppercase;
      }
      .app-nav {
        display: flex;
        gap: 1.5rem;
      }
      .nav-item {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        transition: all 0.2s;
      }
      .nav-item:hover, .nav-item.active {
        color: var(--text-main);
        background: rgba(255, 255, 255, 0.05);
      }
      .header-right {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .system-status {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8rem;
        color: var(--text-muted);
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.2);
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
      }
      .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: var(--color-bull);
        box-shadow: 0 0 8px var(--color-bull);
      }
      .main-content {
        flex: 1;
        padding: 1.5rem;
        max-width: 1600px;
        margin: 0 auto;
        width: 100%;
      }
    </style>

    <script>
      import { logout } from '../lib/api';

      document.getElementById('logoutBtn')?.addEventListener('click', () => {
        logout();
      });

      const themeBtn = document.getElementById('themeToggleBtn');
      const applyIcon = () => {
        const theme = document.documentElement.getAttribute('data-theme') || 'dark';
        if (themeBtn) themeBtn.textContent = theme === 'dark' ? '🌙' : '☀️';
      };
      applyIcon();
      themeBtn?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme') || 'dark';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        applyIcon();
      });
    </script>
  </body>
</html>
