---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'AI Algorithmic Trading Platform' } = Astro.props;

// Icon rail. Primary items sit up top; Profile (formerly "Connector") is pinned to the
// bottom of the rail, right above the connection dot + logout.
const topNav = [
  {
    href: '/',
    label: 'Dashboard',
    icon: '<path d="M3 12 12 3l9 9"/><path d="M5 10v10h5v-6h4v6h5V10"/>',
  },
  {
    href: '/strategies',
    label: 'Alpha',
    icon: '<path d="M9 3h6"/><path d="M10 3v6l-4.5 8A2 2 0 0 0 7.3 20h9.4a2 2 0 0 0 1.8-3L14 9V3"/>',
  },
];

const profileNav = {
  href: '/profile',
  label: 'Profile',
  icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/>',
};

const navItems = [...topNav, profileNav];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const pageTitle = navItems.find((n) => n.href === currentPath)?.label ?? title;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#070b14" />
    <title>{title}</title>
    <meta name="description" content="AI-assisted multi-provider algorithmic trading platform" />
  </head>
  <body class="flex min-h-screen">
    <!-- Left icon rail -->
    <aside class="flex w-16 flex-shrink-0 flex-col items-center border-r border-border bg-panel">
      <div class="flex h-16 w-full items-center justify-center border-b border-border">
        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand shadow-[0_2px_12px_rgba(0,200,150,0.3)]">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#04140e" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
          </svg>
        </div>
      </div>

      <nav class="flex flex-1 flex-col items-center gap-1.5 py-4" aria-label="Primary">
        {topNav.map((item) => {
          const active = currentPath === item.href;
          return (
            <a
              href={item.href}
              title={item.label}
              aria-label={item.label}
              aria-current={active ? 'page' : undefined}
              class={`group relative flex h-11 w-11 flex-col items-center justify-center gap-0.5 rounded-lg transition-colors ${
                active ? 'bg-brand/10 text-brand' : 'text-muted hover:bg-surface-2 hover:text-fg'
              }`}
            >
              <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
              <span class="text-[0.5rem] font-semibold tracking-wide">{item.label}</span>
              {active && <span class="absolute left-0 top-1/2 h-6 w-0.5 -translate-y-1/2 rounded-r bg-brand"></span>}
            </a>
          );
        })}
      </nav>

      <div class="flex flex-col items-center gap-3 pb-5">
        {(() => {
          const active = currentPath === profileNav.href;
          return (
            <a
              href={profileNav.href}
              title={profileNav.label}
              aria-label={profileNav.label}
              aria-current={active ? 'page' : undefined}
              class={`group relative flex h-11 w-11 flex-col items-center justify-center gap-0.5 rounded-lg transition-colors ${
                active ? 'bg-brand/10 text-brand' : 'text-muted hover:bg-surface-2 hover:text-fg'
              }`}
            >
              <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={profileNav.icon} />
              <span class="text-[0.5rem] font-semibold tracking-wide">{profileNav.label}</span>
              {active && <span class="absolute left-0 top-1/2 h-6 w-0.5 -translate-y-1/2 rounded-r bg-brand"></span>}
            </a>
          );
        })()}
        <span class="my-0.5 h-px w-6 bg-border" aria-hidden="true"></span>
        <span id="railConnDot" class="h-2 w-2 rounded-full bg-dim" title="Connection status" aria-hidden="true"></span>
        <button
          id="logoutBtn"
          type="button"
          title="Log out"
          aria-label="Log out"
          class="flex h-11 w-11 items-center justify-center rounded-lg text-muted transition-colors hover:bg-surface-2 hover:text-bear"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="M16 17l5-5-5-5" /><path d="M21 12H9" />
          </svg>
        </button>
      </div>
    </aside>

    <!-- Main column -->
    <div class="flex min-w-0 flex-1 flex-col">
      <header class="sticky top-0 z-40 flex h-16 flex-shrink-0 items-center justify-between border-b border-border bg-panel/90 px-6 backdrop-blur">
        <h1 class="text-base font-semibold text-fg">{pageTitle}</h1>
        <div class="flex items-center gap-4">
          <a id="hdrAlphaChip" href="/strategies" hidden class="inline-flex items-center gap-1.5 rounded-md border border-brand/30 bg-brand/10 px-2.5 py-1 text-[0.7rem] font-semibold text-brand transition-colors hover:bg-brand/20" title="Active strategy">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/></svg>
            <span id="hdrAlphaName" class="max-w-[16ch] truncate"></span>
          </a>
          <span id="hdrLlmChip" class="hidden items-center rounded-md border border-border bg-surface-2 px-2.5 py-1 text-[0.7rem] font-medium tabular text-muted md:inline-flex" title="Total LLM spend">LLM: —</span>
          <!-- Network toggle: switches account/trade APIs + keys between Binance mainnet and
               testnet. Market data always comes from mainnet, so charts are unaffected. -->
          <div id="netToggle" hidden class="flex items-center gap-2">
            <div class="flex items-center rounded-md border border-border bg-surface-2 p-0.5 text-[0.7rem] font-semibold" role="group" aria-label="Trading network">
              <button id="netMainnet" type="button" class="rounded px-2 py-1 text-muted transition-colors" title="Binance mainnet (real funds)">Mainnet</button>
              <button id="netTestnet" type="button" class="rounded px-2 py-1 text-muted transition-colors" title="Binance testnet (paper funds)">Testnet</button>
            </div>
            <a id="netKeysPrompt" href="/profile" hidden class="text-[0.7rem] font-semibold text-amber-400 hover:underline" title="This network has no API keys yet — live orders are blocked until you add them">+ add keys</a>
          </div>
          <span id="connPill" class="flex items-center gap-2 text-xs tracking-wide text-muted">
            <span id="connIco" class="h-2 w-2 rounded-full bg-dim"></span>
            <span id="connText">CHECKING…</span>
          </span>
          <span id="topbarClock" class="tabular text-xs text-muted">--:--:--&nbsp;UTC</span>
          <span class="hidden items-center gap-2 text-xs tracking-wide text-muted sm:flex">
            <span class="live-dot"></span> SYSTEM&nbsp;NOMINAL
          </span>
        </div>
      </header>

      <main class="min-h-0 flex-1 p-6">
        <slot />
      </main>
    </div>

    <script>
      import { logout, apiGet, apiPatch } from '../lib/api';
      import { resolveBtcTicker } from '../lib/ticker';

      document.getElementById('logoutBtn')?.addEventListener('click', () => logout());

      // ---- Header chips: active strategy + cumulative LLM spend (shared across pages) ----
      const hdrAlphaChip = document.getElementById('hdrAlphaChip') as HTMLAnchorElement | null;
      const hdrAlphaName = document.getElementById('hdrAlphaName');
      const hdrLlmChip = document.getElementById('hdrLlmChip');

      async function refreshActiveStrategy() {
        if (!localStorage.getItem('jwt') || !hdrAlphaChip) return;
        try {
          const ticker = await resolveBtcTicker();
          if (!ticker) { hdrAlphaChip.hidden = true; return; }
          const res = await apiGet<{ strategy: { parametersJson?: any; version: number } } | null>(`/strategies/ticker/${ticker.id}/active`);
          if (!res?.strategy) { hdrAlphaChip.hidden = true; if (hdrAlphaName) hdrAlphaName.textContent = ''; return; }
          if (hdrAlphaName) hdrAlphaName.textContent = res.strategy.parametersJson?.strategyName || `Strategy v${res.strategy.version}`;
          hdrAlphaChip.hidden = false;
        } catch { hdrAlphaChip.hidden = true; }
      }

      async function refreshLlmSpend() {
        if (!localStorage.getItem('jwt') || !hdrLlmChip) return;
        try {
          const s = await apiGet<{ totalCostUsd: number; totalCalls: number }>('/llm/cost-summary');
          hdrLlmChip.textContent = `LLM: $${Number(s.totalCostUsd).toFixed(4)} · ${s.totalCalls} calls`;
        } catch { hdrLlmChip.textContent = 'LLM: n/a'; }
      }

      refreshActiveStrategy();
      refreshLlmSpend();
      (window as any).refreshActiveStrategy = refreshActiveStrategy;
      (window as any).refreshLlmSpend = refreshLlmSpend;

      // Live UTC clock (Intl for locale-safe formatting).
      const clockEl = document.getElementById('topbarClock');
      const fmt = new Intl.DateTimeFormat('en-GB', {
        hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false, timeZone: 'UTC',
      });
      const tick = () => { if (clockEl) clockEl.innerHTML = `${fmt.format(new Date())}&nbsp;UTC`; };
      tick();
      setInterval(tick, 1000);

      // Shared connection indicator — a Binance provider with stored credentials means
      // "connected" (i.e. live trading is enabled). Market data does NOT depend on this.
      type NetInfo = { mainnet: boolean; testnet: boolean };
      type ProviderLite = { id: string; type: string; hasCredentials?: boolean; tradingMode?: string; useTestnet?: boolean; networks?: NetInfo };
      const connPill = document.getElementById('connPill');
      const connIco = document.getElementById('connIco');
      const connText = document.getElementById('connText');
      const railDot = document.getElementById('railConnDot');

      // ---- Network (mainnet/testnet) toggle ----
      const netToggle = document.getElementById('netToggle');
      const netMainnet = document.getElementById('netMainnet');
      const netTestnet = document.getElementById('netTestnet');
      const netKeysPrompt = document.getElementById('netKeysPrompt') as HTMLAnchorElement | null;
      let netProviderId: string | null = null;
      let switching = false;

      function paintNetToggle(useTestnet: boolean, networks?: NetInfo) {
        const on = 'bg-brand/15 text-brand';
        const off = 'text-muted';
        [netMainnet, netTestnet].forEach((b) => b?.classList.remove('bg-brand/15', 'text-brand', 'text-muted'));
        (useTestnet ? netTestnet : netMainnet)?.classList.add(...on.split(' '));
        (useTestnet ? netMainnet : netTestnet)?.classList.add(off);
        // Prompt to add keys when the SELECTED network has none (live orders blocked).
        const activeHasKeys = useTestnet ? networks?.testnet : networks?.mainnet;
        if (netKeysPrompt) {
          netKeysPrompt.hidden = !!activeHasKeys;
          netKeysPrompt.textContent = `+ add ${useTestnet ? 'testnet' : 'mainnet'} keys`;
        }
      }

      async function switchNetwork(useTestnet: boolean) {
        if (!netProviderId || switching) return;
        switching = true;
        try {
          await apiPatch(`/providers/${netProviderId}/trading-mode`, { useTestnet });
          await refreshConnection();
        } catch (e) { console.error('Network switch failed', e); }
        finally { switching = false; }
      }
      netMainnet?.addEventListener('click', () => switchNetwork(false));
      netTestnet?.addEventListener('click', () => switchNetwork(true));

      async function refreshConnection() {
        if (!localStorage.getItem('jwt')) return;
        try {
          const providers = await apiGet<ProviderLite[]>('/providers');
          // The user's trading Binance provider = a binance provider that has keys for at
          // least one network (the seeded public-data provider never does). Distinct from
          // "connected", which means the CURRENTLY-selected network has keys.
          const trading = providers.find((p) => p.type === 'binance' && (p.networks?.mainnet || p.networks?.testnet))
            || providers.find((p) => p.type === 'binance' && p.hasCredentials);
          const connected = !!trading?.hasCredentials;
          (window as any).__connection = { connected, provider: trading || null };
          window.dispatchEvent(new CustomEvent('connection-ready', { detail: (window as any).__connection }));

          const net = trading?.useTestnet ? 'TESTNET' : 'MAINNET';
          if (connText) connText.textContent = connected ? `BINANCE ${net}` : (trading ? `NOT CONNECTED · ${net}` : 'NOT CONNECTED');
          connIco?.classList.toggle('bg-brand', connected);
          connIco?.classList.toggle('bg-dim', !connected);
          railDot?.classList.toggle('bg-brand', connected);
          railDot?.classList.toggle('bg-dim', !connected);
          connPill?.classList.toggle('text-brand', connected);

          // Show the network toggle once a trading provider exists.
          if (trading && netToggle) {
            netProviderId = trading.id;
            netToggle.hidden = false;
            paintNetToggle(!!trading.useTestnet, trading.networks);
          } else if (netToggle) {
            netToggle.hidden = true;
          }
        } catch {
          if (connText) connText.textContent = 'NOT CONNECTED';
        }
      }
      refreshConnection();
      (window as any).refreshConnection = refreshConnection;
    </script>
  </body>
</html>
