---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#070b14" />
    <title>Terminal Access — AI Algorithmic Trading Platform</title>
  </head>
  <body class="flex min-h-screen flex-col items-center justify-center gap-5 p-6">
    <div class="flex items-center gap-2.5">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand text-sm shadow-[0_2px_12px_rgba(0,200,150,0.3)]" aria-hidden="true">⚡</span>
      <span class="text-base font-bold tracking-[0.2em]">ALPHATRADE</span>
    </div>

    <div class="card w-full max-w-sm p-7">
      <p id="eyebrow" class="eyebrow text-brand">Terminal Access</p>
      <h2 id="authTitle" class="mb-6 mt-1.5 text-xl font-bold">Sign In</h2>

      <div id="authTabs" class="mb-5 flex gap-1.5">
        <button type="button" data-mode="login" class="auth-tab flex-1 rounded-lg border border-border bg-surface-2 px-3 py-2 text-xs font-bold transition-colors">Sign In</button>
        <button type="button" data-mode="register" class="auth-tab flex-1 rounded-lg border border-border bg-surface-2 px-3 py-2 text-xs font-bold transition-colors">Sign Up</button>
      </div>

      <form id="authForm" class="flex flex-col gap-4">
        <div>
          <label class="label" for="email">Email</label>
          <input class="input" type="email" id="email" name="email" autocomplete="email" spellcheck="false" placeholder="trader@example.com" required />
        </div>
        <div id="passwordField">
          <label class="label" for="password">Password</label>
          <input class="input" type="password" id="password" name="password" autocomplete="current-password" minlength="6" placeholder="••••••••" />
        </div>
        <p id="authError" class="text-sm text-bear" hidden></p>
        <p id="authOk" class="break-words text-xs text-brand" hidden></p>
        <button type="submit" id="submitBtn" class="btn btn-primary mt-1 w-full">Enter Terminal</button>
      </form>

      <div class="mt-5 flex justify-center">
        <button type="button" id="forgotLink" class="text-xs text-muted transition-colors hover:text-brand">Forgot password?</button>
        <button type="button" id="backLink" hidden class="text-xs text-muted transition-colors hover:text-brand">← Back to sign in</button>
      </div>
    </div>
    <p class="text-[0.65rem] tracking-wide text-dim">v2.1.0 · ALPHATRADE PLATFORM</p>

    <script>
      import { apiPost, setToken, ApiError } from '../lib/api';

      if (localStorage.getItem('jwt')) window.location.href = '/';

      type Mode = 'login' | 'register' | 'forgot';
      let mode: Mode = 'login';
      const $ = (id: string) => document.getElementById(id)!;
      const tabs = $('authTabs'), form = $('authForm') as HTMLFormElement, submitBtn = $('submitBtn') as HTMLButtonElement;
      const errorEl = $('authError'), okEl = $('authOk'), passwordInput = $('password') as HTMLInputElement, passwordField = $('passwordField');
      const emailInput = $('email') as HTMLInputElement, title = $('authTitle'), eyebrow = $('eyebrow');
      const forgotLink = $('forgotLink') as HTMLButtonElement, backLink = $('backLink') as HTMLButtonElement;

      function paintTabs() {
        tabs.querySelectorAll<HTMLButtonElement>('.auth-tab').forEach((b) => {
          const on = b.dataset.mode === mode;
          b.classList.toggle('bg-brand', on); b.classList.toggle('text-[#04140e]', on);
          b.classList.toggle('border-brand', on); b.classList.toggle('text-muted', !on);
        });
      }
      function setMode(next: Mode) {
        mode = next; errorEl.hidden = true; okEl.hidden = true;
        tabs.hidden = mode === 'forgot'; forgotLink.hidden = mode === 'forgot'; backLink.hidden = mode !== 'forgot';
        passwordField.hidden = mode === 'forgot'; passwordInput.required = mode !== 'forgot';
        passwordInput.autocomplete = mode === 'login' ? 'current-password' : 'new-password';
        if (mode === 'login') { title.textContent = 'Sign In'; eyebrow.textContent = 'Terminal Access'; submitBtn.textContent = 'Enter Terminal'; }
        else if (mode === 'register') { title.textContent = 'Sign Up'; eyebrow.textContent = 'Create Account'; submitBtn.textContent = 'Create Account'; }
        else { title.textContent = 'Reset Password'; eyebrow.textContent = 'Account Recovery'; submitBtn.textContent = 'Send Reset Link'; }
        paintTabs();
      }
      tabs.querySelectorAll<HTMLButtonElement>('.auth-tab').forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode as Mode)));
      forgotLink.addEventListener('click', () => setMode('forgot'));
      backLink.addEventListener('click', () => setMode('login'));
      paintTabs();

      form.addEventListener('submit', async (e) => {
        e.preventDefault(); errorEl.hidden = true; okEl.hidden = true;
        const email = emailInput.value.trim(), password = passwordInput.value;
        submitBtn.disabled = true; const label = submitBtn.textContent; submitBtn.innerHTML = '<span class="spinner"></span>';
        try {
          if (mode === 'forgot') {
            const res = await apiPost<{ ok: boolean; resetLink?: string }>('/auth/forgot-password', { email });
            okEl.hidden = false;
            okEl.innerHTML = res.resetLink ? `If that email exists, a reset link was created. Dev link: <a class="text-brand underline" href="${res.resetLink}">Reset password</a>` : 'If that email exists, a password reset link has been sent.';
            return;
          }
          const res = await apiPost<{ token?: string; access_token?: string }>(mode === 'login' ? '/auth/login' : '/auth/register', { email, password });
          const token = res?.token || res?.access_token;
          if (!token) throw new Error('Authentication succeeded but no token was returned.');
          setToken(token); window.location.href = '/';
        } catch (err) {
          errorEl.hidden = false; errorEl.textContent = err instanceof ApiError ? err.message : (err instanceof Error ? err.message : 'Something went wrong');
        } finally { submitBtn.disabled = false; submitBtn.textContent = label; }
      });
    </script>
  </body>
</html>
