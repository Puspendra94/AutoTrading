---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log In — AI Algorithmic Trading Platform</title>
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          document.documentElement.setAttribute('data-theme', stored === 'light' ? 'light' : 'dark');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    <div class="login-shell">
      <div class="glass-card login-card">
        <div class="logo login-logo">
          <span class="logo-icon">⚡</span>
          <span class="logo-text">AutoTrade <span class="logo-badge">AI</span></span>
        </div>

        <div class="mode-tabs">
          <button type="button" class="btn btn-outline active" id="loginTab">Log In</button>
          <button type="button" class="btn btn-outline" id="registerTab">Register</button>
        </div>

        <form id="authForm" class="auth-form">
          <div class="field">
            <label for="email">Email</label>
            <input class="text-input" type="email" id="email" name="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="password">Password</label>
            <input class="text-input" type="password" id="password" name="password" autocomplete="current-password" minlength="6" required />
          </div>

          <p class="error-text" id="authError" hidden></p>

          <button type="submit" class="btn btn-primary submit-btn" id="submitBtn">Log In</button>
        </form>

        <p class="hint-text login-hint">
          No account yet? Switch to Register above — a new account is created directly against the backend, no invite needed.
        </p>
      </div>
    </div>

    <style>
      .login-shell {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
      }
      .login-card {
        width: 100%;
        max-width: 400px;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }
      .login-logo {
        justify-content: center;
        font-size: 1.35rem;
      }
      .mode-tabs {
        display: flex;
        gap: 0.5rem;
      }
      .mode-tabs .btn {
        flex: 1;
      }
      .auth-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .submit-btn {
        margin-top: 0.25rem;
        width: 100%;
      }
      .login-hint {
        text-align: center;
      }
    </style>

    <script>
      import { apiPost, setToken, ApiError } from '../lib/api';

      // If already logged in, skip straight to the dashboard.
      if (localStorage.getItem('jwt')) {
        window.location.href = '/';
      }

      type Mode = 'login' | 'register';
      let mode: Mode = 'login';

      const loginTab = document.getElementById('loginTab') as HTMLButtonElement;
      const registerTab = document.getElementById('registerTab') as HTMLButtonElement;
      const form = document.getElementById('authForm') as HTMLFormElement;
      const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
      const errorEl = document.getElementById('authError') as HTMLParagraphElement;
      const passwordInput = document.getElementById('password') as HTMLInputElement;
      const emailInput = document.getElementById('email') as HTMLInputElement;

      function setMode(next: Mode) {
        mode = next;
        loginTab.classList.toggle('active', mode === 'login');
        registerTab.classList.toggle('active', mode === 'register');
        submitBtn.textContent = mode === 'login' ? 'Log In' : 'Create Account';
        passwordInput.setAttribute('autocomplete', mode === 'login' ? 'current-password' : 'new-password');
        errorEl.hidden = true;
      }

      loginTab.addEventListener('click', () => setMode('login'));
      registerTab.addEventListener('click', () => setMode('register'));

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.hidden = true;
        const email = emailInput.value.trim();
        const password = passwordInput.value;

        submitBtn.disabled = true;
        const originalLabel = submitBtn.textContent;
        submitBtn.innerHTML = '<span class="spinner"></span>';

        try {
          const path = mode === 'login' ? '/auth/login' : '/auth/register';
          const res = await apiPost<{ token?: string; access_token?: string }>(path, { email, password });
          // Backend returns { user, token } — accept access_token as a defensive fallback
          // in case the shape changes upstream.
          const token = res?.token || res?.access_token;
          if (!token) {
            throw new Error('Login succeeded but no token was returned by the server.');
          }
          setToken(token);
          window.location.href = '/';
        } catch (err) {
          const message = err instanceof ApiError ? err.message : (err instanceof Error ? err.message : 'Something went wrong');
          errorEl.textContent = message;
          errorEl.hidden = false;
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel;
        }
      });
    </script>
  </body>
</html>
