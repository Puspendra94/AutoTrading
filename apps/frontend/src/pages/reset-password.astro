---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#070b14" />
    <title>Reset Password — AI Algorithmic Trading Platform</title>
  </head>
  <body class="flex min-h-screen flex-col items-center justify-center gap-5 p-6">
    <div class="flex items-center gap-2.5">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand text-sm shadow-[0_2px_12px_rgba(0,200,150,0.3)]" aria-hidden="true">⚡</span>
      <span class="text-base font-bold tracking-[0.2em]">ALPHATRADE</span>
    </div>

    <div class="card w-full max-w-sm p-7">
      <p class="eyebrow text-brand">Account Recovery</p>
      <h2 class="mb-6 mt-1.5 text-xl font-bold">Set a New Password</h2>

      <form id="resetForm" class="flex flex-col gap-4">
        <div>
          <label class="label" for="password">New Password</label>
          <input class="input" type="password" id="password" name="password" autocomplete="new-password" minlength="6" placeholder="••••••••" required />
        </div>
        <div>
          <label class="label" for="confirm">Confirm Password</label>
          <input class="input" type="password" id="confirm" name="confirm" autocomplete="new-password" minlength="6" placeholder="••••••••" required />
        </div>
        <p id="resetError" class="text-sm text-bear" hidden></p>
        <button type="submit" id="resetBtn" class="btn btn-primary mt-1 w-full">Reset Password</button>
      </form>

      <div class="mt-5 flex justify-center">
        <a href="/login" class="text-xs text-muted transition-colors hover:text-brand">← Back to sign in</a>
      </div>
    </div>

    <script>
      import { apiPost, setToken, ApiError } from '../lib/api';

      const params = new URLSearchParams(window.location.search);
      const token = params.get('token') || '';
      const $ = (id: string) => document.getElementById(id)!;
      const form = $('resetForm') as HTMLFormElement, btn = $('resetBtn') as HTMLButtonElement, errEl = $('resetError');
      const pw = $('password') as HTMLInputElement, confirm = $('confirm') as HTMLInputElement;

      if (!token) { errEl.hidden = false; errEl.textContent = 'Missing or invalid reset token. Request a new link from the sign-in page.'; btn.disabled = true; }

      form.addEventListener('submit', async (e) => {
        e.preventDefault(); errEl.hidden = true;
        if (pw.value !== confirm.value) { errEl.hidden = false; errEl.textContent = 'Passwords do not match.'; return; }
        btn.disabled = true; const label = btn.textContent; btn.innerHTML = '<span class="spinner"></span>';
        try {
          const res = await apiPost<{ token?: string }>('/auth/reset-password', { token, password: pw.value });
          if (res?.token) setToken(res.token);
          window.location.href = '/';
        } catch (err) {
          errEl.hidden = false; errEl.textContent = err instanceof ApiError ? err.message : 'Failed to reset password';
          btn.disabled = false; btn.textContent = label;
        }
      });
    </script>
  </body>
</html>
