---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password — AI Algorithmic Trading Platform</title>
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          document.documentElement.setAttribute('data-theme', stored === 'light' ? 'light' : 'dark');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    <div class="auth-shell">
      <div class="auth-brand">
        <span class="auth-logo-mark">⚡</span>
        <span class="auth-logo-text">ALPHATRADE</span>
      </div>

      <div class="glass-card auth-card">
        <p class="auth-eyebrow">Account Recovery</p>
        <h2 class="auth-title">Set a New Password</h2>

        <form id="resetForm" class="auth-form">
          <div class="field">
            <label for="password">New Password</label>
            <input class="text-input" type="password" id="password" name="password" autocomplete="new-password" minlength="6" placeholder="••••••••" required />
          </div>
          <div class="field">
            <label for="confirm">Confirm Password</label>
            <input class="text-input" type="password" id="confirm" name="confirm" autocomplete="new-password" minlength="6" placeholder="••••••••" required />
          </div>

          <p class="error-text" id="resetError" hidden></p>

          <button type="submit" class="btn btn-primary submit-btn" id="resetBtn">Reset Password</button>
        </form>

        <div class="auth-links"><a class="link-btn" href="/login">← Back to sign in</a></div>
      </div>
    </div>

    <style>
      .auth-shell { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.25rem; padding: 1.5rem; }
      .auth-brand { display: flex; align-items: center; gap: 0.5rem; }
      .auth-logo-mark { width: 32px; height: 32px; border-radius: 6px; background: var(--accent-cyan); display: flex; align-items: center; justify-content: center; font-size: 1rem; box-shadow: 0 2px 10px rgba(0, 200, 150, 0.25); }
      .auth-logo-text { font-weight: 700; letter-spacing: 0.2em; font-size: 0.95rem; }
      .auth-card { width: 100%; max-width: 380px; display: flex; flex-direction: column; gap: 0.25rem; padding: 1.75rem; }
      .auth-eyebrow { font-size: 0.6rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent-cyan); }
      .auth-title { font-size: 1.25rem; font-weight: 700; margin: 0.25rem 0 1.1rem; }
      .auth-form { display: flex; flex-direction: column; gap: 0.9rem; }
      .submit-btn { margin-top: 0.35rem; width: 100%; }
      .auth-links { display: flex; justify-content: center; margin-top: 1rem; }
      .link-btn { background: none; border: none; color: var(--text-muted); font-size: 0.68rem; font-family: var(--font-mono); cursor: pointer; text-decoration: none; }
      .link-btn:hover { color: var(--accent-cyan); }
    </style>

    <script>
      import { apiPost, setToken, ApiError } from '../lib/api';

      const params = new URLSearchParams(window.location.search);
      const token = params.get('token') || '';

      const form = document.getElementById('resetForm') as HTMLFormElement;
      const btn = document.getElementById('resetBtn') as HTMLButtonElement;
      const errEl = document.getElementById('resetError') as HTMLParagraphElement;
      const pw = document.getElementById('password') as HTMLInputElement;
      const confirm = document.getElementById('confirm') as HTMLInputElement;

      if (!token) {
        errEl.hidden = false;
        errEl.textContent = 'Missing or invalid reset token. Request a new link from the sign-in page.';
        btn.disabled = true;
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errEl.hidden = true;
        if (pw.value !== confirm.value) {
          errEl.hidden = false;
          errEl.textContent = 'Passwords do not match.';
          return;
        }
        btn.disabled = true;
        const label = btn.textContent;
        btn.innerHTML = '<span class="spinner"></span>';
        try {
          const res = await apiPost<{ token?: string }>('/auth/reset-password', { token, password: pw.value });
          if (res?.token) setToken(res.token);
          window.location.href = '/';
        } catch (err) {
          errEl.hidden = false;
          errEl.textContent = err instanceof ApiError ? err.message : 'Failed to reset password';
          btn.disabled = false;
          btn.textContent = label;
        }
      });
    </script>
  </body>
</html>
