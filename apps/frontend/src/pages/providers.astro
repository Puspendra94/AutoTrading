---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Connector — AI Algorithmic Trading Platform">
  <div class="conn-page" id="connPage">
    <div class="empty-state glass-card" id="connLoading">
      <span class="spinner"></span>
      <p>Loading connector…</p>
    </div>
  </div>

  <style>
    .conn-page { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.25rem; }

    /* --- Connect form (disconnected state) --- */
    .connect-card { display: flex; flex-direction: column; gap: 1rem; }
    .connect-eyebrow { font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-warning); display: flex; align-items: center; gap: 0.4rem; }
    .connect-title { font-size: 1.3rem; font-weight: 700; }
    .connect-desc { font-size: 0.78rem; color: var(--text-muted); }
    .connect-form { display: flex; flex-direction: column; gap: 0.85rem; }
    .warn-box { display: flex; gap: 0.6rem; align-items: flex-start; background: rgba(240, 180, 41, 0.06); border: 1px solid rgba(240, 180, 41, 0.2); border-radius: 6px; padding: 0.7rem; }
    .warn-box span { font-size: 0.68rem; color: var(--text-muted); }

    /* --- Connected state --- */
    .status-bar { display: flex; align-items: center; justify-content: space-between; padding: 0.85rem 1.1rem; }
    .status-left { display: flex; align-items: center; gap: 0.55rem; }
    .status-left .status-dot { width: 8px; height: 8px; }
    .status-name { font-size: 0.85rem; font-weight: 600; }
    .status-key { font-size: 0.65rem; color: var(--text-muted); }

    .cards-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; }
    .info-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 0.9rem 1rem; }
    .info-lbl { font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }
    .info-val { font-size: 1rem; font-weight: 700; margin-top: 0.25rem; }
    .info-sub { font-size: 0.6rem; color: var(--text-dim); margin-top: 0.2rem; }

    .ctrl-card { display: flex; flex-direction: column; gap: 0.9rem; }
    .ctrl-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .ctrl-lbl { font-size: 0.7rem; color: var(--text-muted); }
    .seg { display: flex; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 6px; }
    .seg button { padding: 0.35rem 0.8rem; font-size: 0.7rem; font-weight: 700; font-family: var(--font-mono); background: transparent; border: none; color: var(--text-muted); cursor: pointer; border-radius: 5px; }
    .seg button.active[data-mode="paper"], .seg button.active[data-tn="true"] { background: var(--accent-cyan); color: #070b14; }
    .seg button.active[data-mode="live"], .seg button.active[data-tn="false"] { background: var(--color-bear); color: #fff; }
    .ks-box { border-color: rgba(255, 59, 107, 0.3); background: rgba(255, 59, 107, 0.05); }
    .row-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  </style>

  <script>
    import { apiGet, apiPost, apiPatch, requireAuth, ApiError } from '../lib/api';

    requireAuth();

    type Provider = {
      id: string; name: string; type: string; status: string;
      tradingEnabled: boolean; tradingMode?: 'paper' | 'live'; useTestnet?: boolean;
      hasCredentials?: boolean; killSwitchActive?: boolean; killSwitchReason?: string | null;
      tradableBalance?: number | null; currency?: string | null; lastSyncedAt?: string | null;
    };

    const page = document.getElementById('connPage')!;
    function esc(s: string): string { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }

    async function load() {
      try {
        const providers = await apiGet<Provider[]>('/providers');
        const connected = providers.find((p) => p.type === 'binance' && p.hasCredentials);
        if (connected) renderConnected(connected);
        else renderConnectForm();
      } catch (err) {
        page.innerHTML = `<div class="glass-card empty-state"><p class="error-text">${err instanceof ApiError ? esc(err.message) : 'Failed to load connector'}</p></div>`;
      }
    }

    // ---------- Disconnected: connect form ----------
    function renderConnectForm() {
      page.innerHTML = `
        <div class="glass-card connect-card">
          <div>
            <div class="connect-eyebrow">◆ Binance API</div>
            <h1 class="connect-title">Connect to Binance</h1>
            <p class="connect-desc">Enter your API credentials to enable balance sync and live trading for BTCUSDT. Until connected, the platform stays locked to paper mode.</p>
          </div>
          <form class="connect-form" id="connForm">
            <div class="field">
              <label for="apiKey">API Key</label>
              <input class="text-input" id="apiKey" type="text" autocomplete="off" placeholder="vmPUZELF…" required />
            </div>
            <div class="field">
              <label for="apiSecret">Secret Key</label>
              <input class="text-input" id="apiSecret" type="password" autocomplete="off" placeholder="NhqpR29Lp…" required />
            </div>
            <label class="checkbox-field">
              <input type="checkbox" id="useTestnet" checked />
              Use Binance testnet (recommended until Live mode is verified end-to-end)
            </label>
            <div class="warn-box">
              <span>🛡️ Keys are stored server-side and used only to sync balance and place orders you authorize. Use API keys scoped to spot trading only. Live mode still requires you to explicitly flip the toggle after connecting.</span>
            </div>
            <p class="error-text" id="connErr" hidden></p>
            <button type="submit" class="btn btn-primary" id="connSubmit">Connect to Binance</button>
          </form>
        </div>`;

      const form = document.getElementById('connForm') as HTMLFormElement;
      const errEl = document.getElementById('connErr')!;
      const submit = document.getElementById('connSubmit') as HTMLButtonElement;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errEl.hidden = true;
        const apiKey = (document.getElementById('apiKey') as HTMLInputElement).value.trim();
        const apiSecret = (document.getElementById('apiSecret') as HTMLInputElement).value.trim();
        const useTestnet = (document.getElementById('useTestnet') as HTMLInputElement).checked;
        submit.disabled = true;
        const label = submit.textContent;
        submit.innerHTML = '<span class="spinner"></span>';
        try {
          await apiPost('/providers', { name: 'Binance', type: 'binance', tradingMode: 'paper', useTestnet, apiKey, apiSecret });
          (window as any).refreshConnection?.();
          await load();
        } catch (err) {
          errEl.hidden = false;
          errEl.textContent = err instanceof ApiError ? err.message : 'Failed to connect';
          submit.disabled = false;
          submit.textContent = label;
        }
      });
    }

    // ---------- Connected: status view ----------
    function renderConnected(p: Provider) {
      const mode = p.tradingMode || 'paper';
      const testnet = p.useTestnet !== false;
      const bal = p.tradableBalance != null ? `${Number(p.tradableBalance).toLocaleString(undefined, { maximumFractionDigits: 2 })}` : '—';
      const synced = p.lastSyncedAt ? new Date(p.lastSyncedAt).toLocaleString() : 'never';

      page.innerHTML = `
        <div class="glass-card" style="padding:0">
          <div class="status-bar">
            <div class="status-left">
              <span class="status-dot"></span>
              <span class="status-name">Binance Connected</span>
              <span class="status-key">${testnet ? 'Testnet' : 'Mainnet'} · spot</span>
            </div>
            <button class="btn btn-outline sync-btn" id="syncBtn">Sync Balance</button>
          </div>
        </div>

        <div class="cards-row">
          <div class="info-card">
            <div class="info-lbl">Tradable Balance</div>
            <div class="info-val mono text-bull">${bal} ${esc(p.currency || 'USDT')}</div>
            <div class="info-sub">Last synced: ${esc(synced)}</div>
          </div>
          <div class="info-card">
            <div class="info-lbl">Trading Mode</div>
            <div class="info-val mono ${mode === 'live' ? 'text-bear' : 'text-bull'}">${mode.toUpperCase()}</div>
            <div class="info-sub">${mode === 'live' ? 'Places real orders' : 'Simulated fills, real prices'}</div>
          </div>
          <div class="info-card">
            <div class="info-lbl">Status</div>
            <div class="info-val mono">${esc((p.status || 'active').toUpperCase())}</div>
            <div class="info-sub">Trading ${p.tradingEnabled ? 'enabled' : 'disabled'}</div>
          </div>
        </div>

        <div class="glass-card ctrl-card">
          <div class="ctrl-row">
            <span class="ctrl-lbl">Trading Mode</span>
            <div class="seg" id="modeSeg">
              <button data-mode="paper" class="${mode === 'paper' ? 'active' : ''}">PAPER</button>
              <button data-mode="live" class="${mode === 'live' ? 'active' : ''}">LIVE</button>
            </div>
          </div>
          <div class="ctrl-row">
            <span class="ctrl-lbl">Network</span>
            <div class="seg" id="tnSeg">
              <button data-tn="true" class="${testnet ? 'active' : ''}">TESTNET</button>
              <button data-tn="false" class="${!testnet ? 'active' : ''}">MAINNET</button>
            </div>
          </div>
          <p class="error-text" id="ctrlErr" hidden></p>
        </div>

        ${p.killSwitchActive ? `
        <div class="glass-card ctrl-card ks-box">
          <div class="ctrl-row">
            <div>
              <div class="info-lbl" style="color:var(--color-bear)">Kill Switch Active</div>
              <div class="info-sub">${esc(p.killSwitchReason || 'Manually triggered')}</div>
            </div>
            <button class="btn btn-outline" id="clearKsBtn">Clear Kill Switch</button>
          </div>
        </div>` : ''}`;

      const ctrlErr = document.getElementById('ctrlErr')!;
      const patchMode = async (tradingMode: 'paper' | 'live') => {
        try { await apiPatch(`/providers/${p.id}/trading-mode`, { tradingMode }); (window as any).refreshConnection?.(); await load(); }
        catch (err) { ctrlErr.hidden = false; ctrlErr.textContent = err instanceof ApiError ? err.message : 'Failed to update mode'; }
      };
      const patchNet = async (useTestnet: boolean) => {
        try { await apiPatch(`/providers/${p.id}/trading-mode`, { useTestnet }); await load(); }
        catch (err) { ctrlErr.hidden = false; ctrlErr.textContent = err instanceof ApiError ? err.message : 'Failed to update network'; }
      };
      document.getElementById('modeSeg')!.querySelectorAll<HTMLButtonElement>('button').forEach((b) =>
        b.addEventListener('click', () => patchMode(b.dataset.mode as 'paper' | 'live')));
      document.getElementById('tnSeg')!.querySelectorAll<HTMLButtonElement>('button').forEach((b) =>
        b.addEventListener('click', () => patchNet(b.dataset.tn === 'true')));

      document.getElementById('syncBtn')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        btn.disabled = true; const l = btn.textContent; btn.innerHTML = '<span class="spinner"></span>';
        try { await apiPost(`/providers/${p.id}/sync-balance`); await load(); }
        catch (err) { ctrlErr.hidden = false; ctrlErr.textContent = err instanceof ApiError ? err.message : 'Failed to sync balance'; btn.disabled = false; btn.textContent = l; }
      });

      document.getElementById('clearKsBtn')?.addEventListener('click', async () => {
        try { await apiPost(`/providers/${p.id}/kill-switch/clear`); await load(); } catch { /* surfaced on reload */ }
      });
    }

    load();
  </script>
</Layout>
