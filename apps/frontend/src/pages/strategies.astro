---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Alpha — AI Algorithmic Trading Platform">
  <div class="mx-auto flex max-w-4xl flex-col gap-5 font-mono">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-xl font-bold tracking-tight">Alpha Strategies</h2>
        <p id="ahSub" class="mt-1 text-sm text-muted">Loading…</p>
      </div>
      <div class="flex items-center gap-2">
        <label class="flex items-center gap-1.5 text-xs text-muted">
          Timeframe
          <select id="genInterval" class="rounded-md border border-border bg-surface-2 px-2 py-1.5 text-xs font-semibold text-fg" title="Timeframe to generate, backtest & trade this strategy on. Shorter = trades sooner (faster to test).">
            <option value="">Auto (planner)</option>
            <option value="5m">5m</option>
            <option value="15m">15m</option>
            <option value="30m">30m</option>
            <option value="1h">1h</option>
            <option value="2h">2h</option>
            <option value="4h">4h</option>
            <option value="1d">1d</option>
          </select>
        </label>
        <label class="flex items-center gap-1.5 text-xs text-muted" title="Testing only: promote the generated strategy even if it FAILS the evaluation gate, so you can exercise the auto-trading loop on any timeframe.">
          <input type="checkbox" id="genSkipGate" class="accent-brand" /> Bypass gate <span class="text-warn">(test)</span>
        </label>
        <button id="genBtn" class="btn btn-primary">⚡ Generate New Strategy</button>
      </div>
    </div>

    <p id="alphaError" class="text-sm text-bear" hidden></p>

    <!-- Policy thresholds -->
    <div id="policyStrip" class="card flex flex-wrap gap-x-8 gap-y-3 px-5 py-4">
      <p class="text-sm text-muted">Loading policy thresholds…</p>
    </div>

    <div id="activeWrap"></div>

    <div>
      <div class="mb-2 flex items-center justify-between">
        <span class="eyebrow">All Strategies</span>
        <span id="listRange" class="text-xs text-muted"></span>
      </div>
      <div id="listCard" class="card overflow-hidden"><p class="p-4 text-sm text-muted">Loading strategies…</p></div>
      <div id="pager" class="mt-3 flex justify-center gap-1.5"></div>
    </div>
  </div>

  <!-- Generation pipeline modal -->
  <div id="genModal" hidden class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4 backdrop-blur-sm" style="overscroll-behavior: contain;">
    <div class="card w-full max-w-md p-6" role="dialog" aria-modal="true" aria-label="Generating strategy">
      <div class="flex items-center gap-2"><span class="spinner"></span><span class="eyebrow text-brand">Generating Alpha</span></div>
      <h3 id="genName" class="mt-2 text-lg font-bold">New Strategy</h3>
      <div class="my-4 h-1.5 overflow-hidden rounded-full bg-surface-2"><div id="genBarFill" class="h-full w-0 rounded-full bg-brand transition-[width] duration-500"></div></div>
      <div id="genStages" class="flex flex-col gap-2.5"></div>
      <p class="mt-4 text-center text-xs text-muted">Real LLM generation + backtest running · do not close</p>
    </div>
  </div>

  <script>
    import { apiGet, apiPost, requireAuth, ApiError } from '../lib/api';
    import { resolveBtcTicker } from '../lib/ticker';

    requireAuth();

    type Policy = { name: string; minSharpe: number; maxDrawdownPct: number; minProfitFactor: number; minTradeCount: number; isActive: boolean };
    type Backtest = { sharpe: number; sortino: number; maxDrawdown: number; profitFactor: number; tradeCount: number; totalReturnPct: number; winRate: number; passedEvaluationGate: boolean };
    type Strategy = { id: string; version: number; status: string; executionMode: string; createdAt: string; parametersJson?: any };
    type StrategyRow = { strategy: Strategy; backtest: Backtest | null };

    const PER_PAGE = 5;
    const STAGES = ['Checking active trades', 'Generating alpha signals', 'Backtesting historical data', 'Verifying on live data', 'Applying evaluation gate', 'Promoting strategy'];
    const $ = (id: string) => document.getElementById(id)!;
    const esc = (s: string) => { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; };
    const nameOf = (s: Strategy) => s.parametersJson?.strategyName || `Strategy v${s.version}`;
    const descOf = (s: Strategy) => s.parametersJson?.reasoning || modeLabel(s.executionMode);
    const modeLabel = (m: string) => (m === 'mode_a_rules' ? 'Mode A · Rules' : 'Mode B · AI Live');
    const isoDate = (d: string) => new Date(d).toISOString().slice(0, 10);

    const playIcon = '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="6 4 20 12 6 20"/></svg>';

    let tickerId: string | null = null, strategyRows: StrategyRow[] = [], activeId: string | null = null, pg = 1;

    // Shared metric line: signed return (coloured) · win rate · sharpe · trades · date.
    // Falls back to a muted "awaiting backtest" note when a version has no backtest yet.
    function metricsRow(bt: Backtest | null, createdAt: string): string {
      const date = isoDate(createdAt);
      if (!bt) return `<div class="mt-2 text-xs text-dim tabular">Awaiting backtest · ${date}</div>`;
      const ret = Number(bt.totalReturnPct);
      const retCls = ret >= 0 ? 'text-brand' : 'text-bear';
      const sign = ret >= 0 ? '+' : '';
      return `<div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted tabular">
        <span class="font-bold ${retCls}">${sign}${ret.toFixed(1)}%</span>
        <span>WR: ${Number(bt.winRate).toFixed(1)}%</span>
        <span>Sharpe: ${Number(bt.sharpe).toFixed(2)}</span>
        <span>${bt.tradeCount} trades</span>
        <span>${date}</span>
      </div>`;
    }

    async function loadPolicy() {
      try {
        const policies = await apiGet<Policy[]>('/strategies/policies');
        const a = policies.find((p) => p.isActive) || policies[0];
        if (!a) { $('policyStrip').innerHTML = `<p class="text-sm text-muted">No evaluation policy configured.</p>`; return; }
        const pol = (label: string, val: string, cls = 'text-fg') => `<div class="flex flex-col gap-0.5"><span class="eyebrow">${label}</span><span class="tabular text-sm font-bold ${cls}">${val}</span></div>`;
        $('policyStrip').innerHTML =
          pol('Policy', esc(a.name), 'text-brand') + pol('Min Sharpe', `≥ ${Number(a.minSharpe).toFixed(2)}`) +
          pol('Max Drawdown', `≤ ${Number(a.maxDrawdownPct).toFixed(1)}%`) + pol('Min Profit Factor', `≥ ${Number(a.minProfitFactor).toFixed(2)}`) +
          pol('Min Trades', `≥ ${a.minTradeCount}`);
      } catch { $('policyStrip').innerHTML = `<p class="text-sm text-muted">Failed to load policy thresholds.</p>`; }
    }

    function renderActive() {
      const row = strategyRows.find((r) => r.strategy.id === activeId);
      if (!row) { $('activeWrap').innerHTML = ''; return; }
      const s = row.strategy;
      $('activeWrap').innerHTML = `
        <div class="mb-2 flex items-center gap-2 eyebrow"><span class="h-1.5 w-1.5 rounded-full bg-brand"></span>Active Strategy</div>
        <div class="card border-brand/30 bg-brand/[0.03] p-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-warn" aria-hidden="true">★</span>
            <span class="text-[0.95rem] font-bold">${esc(nameOf(s))}</span>
            <span class="badge badge-brand">ACTIVE</span>
          </div>
          <div class="mt-1 truncate text-xs text-muted">${esc(descOf(s))}</div>
          ${metricsRow(row.backtest, s.createdAt)}
        </div>`;
    }

    function renderList() {
      const inactive = strategyRows.filter((r) => r.strategy.id !== activeId);
      const totalPages = Math.max(1, Math.ceil(inactive.length / PER_PAGE));
      if (pg > totalPages) pg = totalPages;
      const paged = inactive.slice((pg - 1) * PER_PAGE, pg * PER_PAGE);
      $('listRange').textContent = inactive.length ? `${(pg - 1) * PER_PAGE + 1}–${Math.min(pg * PER_PAGE, inactive.length)} of ${inactive.length}` : '';

      $('listCard').innerHTML = !inactive.length
        ? `<p class="p-4 text-sm text-muted">No other strategy versions yet.</p>`
        : paged.map((r) => {
            const s = r.strategy;
            return `
            <div class="flex items-start justify-between gap-4 border-b border-border/60 px-4 py-4 last:border-0">
              <div class="min-w-0">
                <div class="text-sm font-bold text-fg">${esc(nameOf(s))}</div>
                <div class="mt-0.5 truncate text-xs text-muted">${esc(descOf(s))}</div>
                ${metricsRow(r.backtest, s.createdAt)}
              </div>
              <button data-activate="${s.id}" class="inline-flex flex-shrink-0 items-center gap-1.5 rounded-md border border-brand/40 px-3 py-1.5 text-xs font-semibold text-brand transition-colors hover:bg-brand/10 disabled:opacity-40">
                ${playIcon} Activate
              </button>
            </div>`;
          }).join('');

      $('listCard').querySelectorAll<HTMLButtonElement>('button[data-activate]').forEach((b) =>
        b.addEventListener('click', () => activate(b.dataset.activate!, b)));

      $('pager').innerHTML = totalPages > 1 ? (() => {
        const b = (n: number, label: string, disabled = false, active = false) =>
          `<button ${disabled ? 'disabled' : ''} data-pg="${n}" class="h-8 min-w-8 rounded-md border px-2 text-xs font-semibold transition-colors ${active ? 'border-brand bg-brand/10 text-brand' : 'border-border text-muted hover:text-fg'} disabled:opacity-30">${label}</button>`;
        let h = b(pg - 1, '‹', pg === 1);
        for (let n = 1; n <= totalPages; n++) h += b(n, String(n), false, n === pg);
        return h + b(pg + 1, '›', pg === totalPages);
      })() : '';
      $('pager').querySelectorAll<HTMLButtonElement>('button[data-pg]').forEach((b) => b.addEventListener('click', () => { pg = Number(b.dataset.pg); renderList(); }));
    }

    async function activate(strategyId: string, btn: HTMLButtonElement) {
      if (!confirm('Activate this strategy version? The currently active strategy will be retired.')) return;
      $('alphaError').hidden = true;
      btn.disabled = true;
      btn.innerHTML = `<span class="spinner" style="width:13px;height:13px"></span> Activating…`;
      try {
        await apiPost(`/strategies/${strategyId}/activate`);
        await loadStrategies(); // re-renders the whole list, so the button is replaced
        (window as any).refreshActiveStrategy?.(); // sync the header chip with the swap
      } catch (err) {
        btn.disabled = false; btn.innerHTML = `${playIcon} Activate`;
        $('alphaError').hidden = false; $('alphaError').textContent = err instanceof ApiError ? err.message : 'Activation failed';
      }
    }

    async function loadStrategies() {
      if (!tickerId) return;
      try {
        strategyRows = (await apiGet<StrategyRow[]>(`/strategies/ticker/${tickerId}/all`))
          .sort((a, b) => b.strategy.version - a.strategy.version);
        activeId = strategyRows.find((r) => r.strategy.status === 'live')?.strategy.id ?? null;
        $('ahSub').textContent = `${strategyRows.length} total · ${activeId ? '1 active' : 'none active'}`;
        renderActive(); renderList();
      } catch { $('listCard').innerHTML = `<p class="p-4 text-sm text-muted">Failed to load strategies.</p>`; }
    }

    // Pipeline modal
    const check = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#00c896" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
    const dot = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#55698f" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>';
    const spin = '<span class="spinner" style="width:15px;height:15px"></span>';
    function paintStages(current: number) {
      $('genStages').innerHTML = STAGES.map((label, i) => {
        const done = i < current, running = i === current;
        return `<div class="flex items-center gap-2.5 text-sm ${done ? 'text-fg' : running ? 'text-warn' : 'text-muted'}">${done ? check : running ? spin : dot}<span>${label}</span></div>`;
      }).join('');
      ($('genBarFill') as HTMLElement).style.width = `${Math.round((current / STAGES.length) * 100)}%`;
    }
    async function generate() {
      if (!tickerId) return;
      $('alphaError').hidden = true; $('genName').textContent = 'New Strategy'; $('genModal').hidden = false;
      const genBtn = $('genBtn') as HTMLButtonElement; genBtn.disabled = true;
      let cur = 0; paintStages(cur);
      const timer = setInterval(() => { if (cur < STAGES.length - 1) { cur++; paintStages(cur); } }, 1200);
      try {
        const interval = ($('genInterval') as HTMLSelectElement)?.value || '';
        const skipGate = ($('genSkipGate') as HTMLInputElement)?.checked;
        const params = new URLSearchParams();
        if (interval) params.set('interval', interval);
        if (skipGate) params.set('skipGate', 'true');
        const qs = params.toString() ? `?${params.toString()}` : '';
        const res = await apiPost<{ saved: boolean; attempts?: number; message?: string; evaluation?: any; gateBypassed?: boolean }>(`/strategies/ticker/${tickerId}/generate${qs}`);
        clearInterval(timer); paintStages(STAGES.length);
        await loadStrategies();
        (window as any).refreshLlmSpend?.(); (window as any).refreshActiveStrategy?.();
        // Gate-before-save: nothing is persisted unless a generated candidate clears the gate.
        if (res && res.saved === false) {
          $('genModal').hidden = true; genBtn.disabled = false;
          const sh = res.evaluation ? ` (best Sharpe ${Number(res.evaluation.sharpe).toFixed(2)}, PF ${Number(res.evaluation.profitFactor).toFixed(2)})` : '';
          $('alphaError').hidden = false;
          $('alphaError').className = 'text-sm text-bear';
          $('alphaError').textContent = (res.message || 'No generated strategy passed the evaluation gate.') + sh;
          return;
        }
        if (res?.gateBypassed) {
          const sh = res.evaluation ? ` (Sharpe ${Number(res.evaluation.sharpe).toFixed(2)}, PF ${Number(res.evaluation.profitFactor).toFixed(2)}, ${res.evaluation.tradeCount} trades)` : '';
          $('alphaError').hidden = false;
          $('alphaError').className = 'text-sm text-warn';
          $('alphaError').textContent = `⚠ Promoted with the evaluation gate BYPASSED (testing)${sh}. It's live for exercising auto-trading, not a validated strategy.`;
        }
        setTimeout(() => { $('genModal').hidden = true; genBtn.disabled = false; }, 700);
      } catch (err) {
        clearInterval(timer); $('genModal').hidden = true; genBtn.disabled = false;
        $('alphaError').hidden = false; $('alphaError').className = 'text-sm text-bear';
        $('alphaError').textContent = err instanceof ApiError ? err.message : 'Strategy generation failed';
      }
    }
    $('genBtn').addEventListener('click', generate);

    (async () => {
      loadPolicy();
      const ticker = await resolveBtcTicker();
      if (!ticker) { ($('genBtn') as HTMLButtonElement).disabled = true; $('ahSub').textContent = 'Market data initializing…'; $('listCard').innerHTML = `<p class="p-4 text-sm text-muted">Waiting for BTCUSDT market data…</p>`; return; }
      tickerId = ticker.id;
      await loadStrategies();
    })();
  </script>
</Layout>
