---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard — AI Algorithmic Trading Platform">
  <div class="dash">
    <!-- P/L banner + BTCUSDT live price + mode toggle -->
    <div class="banner glass-card">
      <div class="banner-metrics">
        <div class="sym-block">
          <span class="sym">BTCUSDT</span>
          <span class="sym-price mono" id="livePrice">—</span>
          <span class="sym-change mono" id="priceChange">—</span>
        </div>
        <div class="metric">
          <span class="metric-lbl">Unrealized P/L</span>
          <span class="metric-val mono" id="mUnrealized">—</span>
        </div>
        <div class="metric">
          <span class="metric-lbl">Open Positions</span>
          <span class="metric-val mono" id="mOpen">—</span>
        </div>
        <div class="metric">
          <span class="metric-lbl">Balance</span>
          <span class="metric-val mono" id="mBalance">—</span>
        </div>
      </div>

      <div class="banner-actions">
        <a class="alpha-chip" id="alphaChip" href="/strategies" hidden></a>
        <div class="mode-toggle" id="modeToggle" data-state="locked">
          <span class="mode-lbl">Mode</span>
          <div class="mode-switch">
            <button type="button" class="mode-btn" data-mode="paper" id="modePaper">PAPER</button>
            <button type="button" class="mode-btn" data-mode="live" id="modeLive">LIVE</button>
          </div>
          <span class="mode-locked" id="modeLocked">LOCKED</span>
        </div>
      </div>
    </div>

    <!-- Main: Live Trades + Active Alpha -->
    <div class="dash-grid">
      <section class="glass-card panel">
        <div class="panel-head">
          <span class="panel-title">Live Trades</span>
          <span class="live-tag"><span class="status-dot"></span> LIVE</span>
        </div>
        <div class="positions-list" id="positionsList">
          <p class="hint-text pad">Loading positions…</p>
        </div>
      </section>

      <aside class="glass-card panel">
        <div class="panel-head">
          <span class="panel-title">Active Alpha</span>
        </div>
        <div id="alphaBody">
          <p class="hint-text pad">Loading strategy…</p>
        </div>
      </aside>
    </div>
  </div>

  <style>
    .dash { display: flex; flex-direction: column; gap: 1rem; max-width: 1500px; margin: 0 auto; }

    /* Banner */
    .banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      flex-wrap: wrap;
      padding: 0.9rem 1.25rem;
    }
    .banner-metrics { display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; }
    .sym-block { display: flex; align-items: baseline; gap: 0.6rem; }
    .sym { font-weight: 700; font-size: 0.95rem; letter-spacing: 0.03em; }
    .sym-price { font-size: 1.05rem; font-weight: 700; }
    .sym-change { font-size: 0.8rem; }
    .metric { display: flex; flex-direction: column; gap: 0.15rem; }
    .metric-lbl { font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }
    .metric-val { font-size: 0.95rem; font-weight: 700; }
    .text-bull { color: var(--color-bull); }
    .text-bear { color: var(--color-bear); }

    .banner-actions { display: flex; align-items: center; gap: 1rem; }
    .alpha-chip {
      display: inline-flex; align-items: center; gap: 0.35rem;
      font-size: 0.65rem; letter-spacing: 0.06em;
      color: var(--accent-cyan);
      border: 1px solid rgba(0, 200, 150, 0.3);
      border-radius: 5px; padding: 0.3rem 0.55rem; text-decoration: none;
    }
    .alpha-chip:hover { background: rgba(0, 200, 150, 0.06); }

    /* Mode toggle */
    .mode-toggle { display: flex; align-items: center; gap: 0.6rem; }
    .mode-lbl { font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }
    .mode-switch { display: flex; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 6px; }
    .mode-btn {
      padding: 0.35rem 0.8rem; font-size: 0.7rem; font-weight: 700; font-family: var(--font-mono);
      background: transparent; border: none; color: var(--text-muted); cursor: pointer; border-radius: 5px;
      transition: all 0.15s ease;
    }
    .mode-btn.active[data-mode="paper"] { background: var(--accent-cyan); color: #070b14; }
    .mode-btn.active[data-mode="live"] { background: var(--color-bear); color: #fff; }
    .mode-locked { font-size: 0.6rem; letter-spacing: 0.1em; color: var(--color-warning); animation: pulse-subtle 2s infinite ease-in-out; }
    .mode-toggle[data-state="ready"] { }
    .mode-toggle[data-state="ready"] .mode-locked { display: none; }
    .mode-toggle[data-state="locked"] .mode-switch { opacity: 0.5; pointer-events: none; }

    /* Grid */
    .dash-grid { display: grid; grid-template-columns: 1fr 360px; gap: 1rem; align-items: start; }
    @media (max-width: 1000px) { .dash-grid { grid-template-columns: 1fr; } }

    .panel { padding: 0; overflow: hidden; }
    .panel-head {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0.7rem 1rem; border-bottom: 1px solid var(--border-color);
    }
    .panel-title { font-size: 0.6rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); }
    .live-tag { display: flex; align-items: center; gap: 0.35rem; font-size: 0.6rem; letter-spacing: 0.1em; color: var(--color-bull); }
    .pad { padding: 1rem; }

    /* Positions */
    .positions-list { display: flex; flex-direction: column; }
    .pos-row { padding: 0.75rem 1rem; border-bottom: 1px solid var(--border-color); transition: background 0.15s ease; }
    .pos-row:hover { background: var(--bg-card-hover); }
    .pos-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.35rem; }
    .pos-sym { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; font-size: 0.8rem; }
    .side-tag { font-size: 0.6rem; font-weight: 700; padding: 0.1rem 0.4rem; border-radius: 4px; }
    .side-long { background: rgba(0, 200, 150, 0.12); color: var(--color-bull); }
    .side-short { background: rgba(255, 59, 107, 0.12); color: var(--color-bear); }
    .pos-line { display: flex; justify-content: space-between; font-size: 0.65rem; color: var(--text-muted); margin-top: 0.15rem; }
    .pos-line .mono { color: var(--text-main); }

    /* Alpha body */
    .alpha-inner { padding: 1rem; display: flex; flex-direction: column; gap: 0.9rem; }
    .alpha-name { font-size: 0.9rem; font-weight: 700; }
    .alpha-sub { font-size: 0.65rem; color: var(--text-muted); margin-top: 0.15rem; }
    .alpha-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
    .am { display: flex; flex-direction: column; gap: 0.1rem; background: var(--bg-secondary); border-radius: 6px; padding: 0.5rem 0.6rem; }
    .am-lbl { font-size: 0.58rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); }
    .am-val { font-size: 0.85rem; font-weight: 700; }
  </style>

  <script>
    import { apiGet, apiPatch, requireAuth, ApiError } from '../lib/api';
    import { resolveBtcTicker } from '../lib/ticker';
    import { subscribeTicker, onPriceUpdate, onPositionsUpdate } from '../lib/ws';

    requireAuth();

    type Position = {
      id: string; ticker: { symbol: string }; side: 'long' | 'short';
      entryPrice: number; currentPrice: number; quantity: number;
      unrealizedPl: number; realizedPl: number; isProbation: boolean; openedAt: string;
    };
    type Provider = { id: string; type: string; tradingMode: 'paper' | 'live'; hasCredentials?: boolean; killSwitchActive?: boolean; tradableBalance: number | null; currency: string | null };
    type Strategy = { id: string; version: number; status: string; executionMode: string; parametersJson: any };
    type Backtest = { sharpe: number; profitFactor: number; maxDrawdown: number; tradeCount: number; passedEvaluationGate: boolean };

    const livePriceEl = document.getElementById('livePrice')!;
    const priceChangeEl = document.getElementById('priceChange')!;
    const mUnrealized = document.getElementById('mUnrealized')!;
    const mOpen = document.getElementById('mOpen')!;
    const mBalance = document.getElementById('mBalance')!;
    const positionsList = document.getElementById('positionsList')!;
    const alphaBody = document.getElementById('alphaBody')!;
    const alphaChip = document.getElementById('alphaChip') as HTMLAnchorElement;

    function esc(s: string): string { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }
    function fmt(n: number, d = 2): string { return Number(n).toLocaleString(undefined, { maximumFractionDigits: d }); }

    // ---- BTCUSDT live price (number only, no chart) ----
    let firstOpen: number | null = null;
    onPriceUpdate(({ candle }) => {
      const close = Number(candle.close ?? candle.c);
      if (!Number.isFinite(close)) return;
      if (firstOpen === null) firstOpen = Number(candle.open ?? candle.o) || close;
      livePriceEl.textContent = `$${fmt(close, 2)}`;
      const chg = firstOpen ? ((close - firstOpen) / firstOpen) * 100 : 0;
      priceChangeEl.textContent = `${chg >= 0 ? '+' : ''}${chg.toFixed(2)}%`;
      priceChangeEl.classList.toggle('text-bull', chg >= 0);
      priceChangeEl.classList.toggle('text-bear', chg < 0);
    });

    // ---- Live trades ----
    function renderPositions(positions: Position[]) {
      mOpen.textContent = String(positions.length);
      const unreal = positions.reduce((s, p) => s + Number(p.unrealizedPl || 0), 0);
      mUnrealized.textContent = `${unreal >= 0 ? '+' : ''}$${fmt(unreal, 2)}`;
      mUnrealized.classList.toggle('text-bull', unreal >= 0);
      mUnrealized.classList.toggle('text-bear', unreal < 0);

      if (!positions.length) {
        positionsList.innerHTML = `<p class="hint-text pad">No open positions right now.</p>`;
        return;
      }
      positionsList.innerHTML = positions.map((p) => {
        const bull = Number(p.unrealizedPl) >= 0;
        const plPct = p.entryPrice ? (Number(p.unrealizedPl) / (Number(p.entryPrice) * Number(p.quantity))) * 100 : 0;
        const mins = Math.floor((Date.now() - new Date(p.openedAt).getTime()) / 60000);
        const age = mins < 60 ? `${mins}m` : `${Math.floor(mins / 60)}h ${mins % 60}m`;
        return `
          <div class="pos-row">
            <div class="pos-top">
              <span class="pos-sym">${esc(p.ticker?.symbol || 'BTCUSDT')}
                <span class="side-tag ${p.side === 'long' ? 'side-long' : 'side-short'}">${p.side.toUpperCase()}</span>
              </span>
              <span class="mono ${bull ? 'text-bull' : 'text-bear'}" style="font-weight:700;font-size:0.8rem">${bull ? '+' : ''}$${fmt(Number(p.unrealizedPl), 2)}</span>
            </div>
            <div class="pos-line"><span>Entry</span><span class="mono">$${fmt(Number(p.entryPrice), 2)}</span></div>
            <div class="pos-line"><span>P/L %</span><span class="mono ${bull ? 'text-bull' : 'text-bear'}">${plPct >= 0 ? '+' : ''}${plPct.toFixed(2)}%</span></div>
            <div class="pos-line"><span>Size ${fmt(Number(p.quantity), 6)}</span><span>${p.isProbation ? 'Probation' : 'Full'} · ${age}</span></div>
          </div>`;
      }).join('');
    }

    async function loadPositions() {
      try { renderPositions(await apiGet<Position[]>('/execution/positions/open')); }
      catch { positionsList.innerHTML = `<p class="hint-text pad">Failed to load positions.</p>`; }
    }
    onPositionsUpdate((positions) => renderPositions(positions as Position[]));

    // ---- Active Alpha ----
    async function loadAlpha(tickerId: string) {
      try {
        const result = await apiGet<{ strategy: Strategy; backtest: Backtest } | null>(`/strategies/ticker/${tickerId}/active`);
        if (!result) {
          alphaBody.innerHTML = `<div class="alpha-inner"><p class="hint-text">No active strategy yet. Generate one on the Alpha page.</p><a href="/strategies" class="btn btn-primary" style="width:fit-content">Go to Alpha</a></div>`;
          alphaChip.hidden = true;
          return;
        }
        const { strategy, backtest } = result;
        const name = strategy.parametersJson?.strategyName || 'Generated Strategy';
        alphaChip.hidden = false;
        alphaChip.textContent = `⚡ ${name}`;
        alphaBody.innerHTML = `
          <div class="alpha-inner">
            <div>
              <div class="alpha-name">${esc(name)}</div>
              <div class="alpha-sub">v${strategy.version} · ${strategy.executionMode === 'mode_a_rules' ? 'Mode A · Rules' : 'Mode B · AI Live'} · ${esc(strategy.status.toUpperCase())}</div>
            </div>
            ${backtest ? `
            <div class="alpha-metrics">
              <div class="am"><span class="am-lbl">Sharpe</span><span class="am-val mono">${Number(backtest.sharpe).toFixed(2)}</span></div>
              <div class="am"><span class="am-lbl">Profit Factor</span><span class="am-val mono">${Number(backtest.profitFactor).toFixed(2)}</span></div>
              <div class="am"><span class="am-lbl">Max Drawdown</span><span class="am-val mono">${Number(backtest.maxDrawdown).toFixed(1)}%</span></div>
              <div class="am"><span class="am-lbl">Trades</span><span class="am-val mono">${backtest.tradeCount}</span></div>
              <div class="am" style="grid-column:1/-1"><span class="am-lbl">Eval Gate</span><span class="am-val mono ${backtest.passedEvaluationGate ? 'text-bull' : 'text-bear'}">${backtest.passedEvaluationGate ? 'PASSED' : 'FAILED'}</span></div>
            </div>` : `<p class="hint-text">No backtest metrics recorded.</p>`}
          </div>`;
      } catch (err) {
        alphaBody.innerHTML = `<p class="hint-text pad">${err instanceof ApiError ? esc(err.message) : 'Failed to load strategy'}</p>`;
      }
    }

    // ---- Mode toggle (change #3) ----
    const modeToggle = document.getElementById('modeToggle')!;
    const modePaper = document.getElementById('modePaper') as HTMLButtonElement;
    const modeLive = document.getElementById('modeLive') as HTMLButtonElement;
    let boundProvider: Provider | null = null;

    function paintMode(mode: 'paper' | 'live', locked: boolean) {
      modeToggle.dataset.state = locked ? 'locked' : 'ready';
      modePaper.classList.toggle('active', mode === 'paper');
      modeLive.classList.toggle('active', mode === 'live');
    }

    function applyProviderState(provider: Provider | null) {
      boundProvider = provider;
      const connected = !!provider && !!provider.hasCredentials;
      if (!connected) { paintMode('paper', true); mBalance.textContent = '—'; return; }
      paintMode(provider!.tradingMode || 'paper', false);
      mBalance.textContent = provider!.tradableBalance != null ? `${fmt(provider!.tradableBalance, 2)} ${provider!.currency || ''}`.trim() : '—';
    }

    async function switchMode(mode: 'paper' | 'live') {
      if (!boundProvider || !boundProvider.hasCredentials) return;
      if (mode === boundProvider.tradingMode) return;
      paintMode(mode, false);
      try {
        const updated = await apiPatch<Provider>(`/providers/${boundProvider.id}/trading-mode`, { tradingMode: mode });
        boundProvider.tradingMode = updated.tradingMode;
      } catch (err) {
        // revert on failure
        paintMode(boundProvider.tradingMode, false);
      }
    }
    modePaper.addEventListener('click', () => switchMode('paper'));
    modeLive.addEventListener('click', () => switchMode('live'));

    // Reuse the Layout's shared connection probe when available, else fetch directly.
    async function loadProvider() {
      try {
        const providers = await apiGet<Provider[]>('/providers');
        applyProviderState(providers.find((p) => p.type === 'binance' && p.hasCredentials) || providers.find((p) => p.type === 'binance') || null);
      } catch { applyProviderState(null); }
    }
    window.addEventListener('connection-ready', (e: any) => {
      if (e.detail?.provider) applyProviderState(e.detail.provider as Provider);
    });

    // ---- Init ----
    (async () => {
      loadProvider();
      loadPositions();
      const ticker = await resolveBtcTicker();
      if (ticker) {
        subscribeTicker(ticker.id);
        loadAlpha(ticker.id);
      } else {
        alphaBody.innerHTML = `<div class="alpha-inner"><p class="hint-text">No BTCUSDT ticker yet — connect Binance on the Connector page to begin.</p></div>`;
      }
    })();
  </script>
</Layout>
