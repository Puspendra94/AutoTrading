---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard — AI Algorithmic Trading Platform">
  <div class="dashboard-grid">
    <!-- Main Left Section: Selected Ticker Detail View (Section 16.1) -->
    <div class="main-ticker-view">
      <!-- Top Bar: Ticker Selector & Stats -->
      <div class="glass-card ticker-header">
        <div class="ticker-selector-container">
          <label for="tickerSelect" class="label">Select Ticker:</label>
          <select id="tickerSelect" class="select-input">
            <option value="BTCUSDT">BTC/USDT — Binance Spot</option>
            <option value="ETHUSDT">ETH/USDT — Binance Spot</option>
            <option value="SOLUSDT">SOL/USDT — Binance Spot</option>
          </select>
        </div>

        <div class="price-stat-group">
          <div class="stat-item">
            <span class="stat-label">Live Price</span>
            <span class="stat-value mono" id="livePrice">$65,240.50</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">24h Change</span>
            <span class="stat-value mono text-bull" id="priceChange">+3.42%</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Volume</span>
            <span class="stat-value mono" id="priceVolume">12,450 BTC</span>
          </div>
        </div>

        <div class="onboarding-status">
          <span class="badge badge-info">Status: Live Trading</span>
        </div>
      </div>

      <!-- Real-time Candlestick Price Chart (Section 16.1) -->
      <div class="glass-card chart-card">
        <div class="chart-header">
          <h3 class="chart-title">Real-Time Price & Signal Chart</h3>
          <div class="timeframe-buttons">
            <button class="btn btn-outline active">1m</button>
            <button class="btn btn-outline">5m</button>
            <button class="btn btn-outline">1h</button>
            <button class="btn btn-outline">1d</button>
          </div>
        </div>
        <div class="canvas-container">
          <canvas id="candlestickCanvas" width="900" height="380"></canvas>
        </div>
      </div>

      <!-- Active Strategy Proposal / Action Card (Section 16.1) -->
      <div class="glass-card strategy-card">
        <div class="strategy-card-header">
          <div>
            <h3 class="card-heading">Active Strategy Signal & Execution Mode</h3>
            <p class="card-subtext">Strategy v2 (Mode A: Rules Engine — Zero LLM latency on hot path)</p>
          </div>
          <span class="badge badge-bull">Signal: HOLDING LONG</span>
        </div>

        <div class="strategy-details-grid">
          <div class="detail-box">
            <span class="detail-label">Strategy Model</span>
            <span class="detail-val">Adaptive Trend Breakout</span>
          </div>
          <div class="detail-box">
            <span class="detail-label">Entry Price</span>
            <span class="detail-val mono">$64,850.00</span>
          </div>
          <div class="detail-box">
            <span class="detail-label">Unrealized P/L</span>
            <span class="detail-val mono text-bull">+$390.50 (+0.60%)</span>
          </div>
          <div class="detail-box">
            <span class="detail-label">Position Sizing</span>
            <span class="detail-val">Probation (25% size)</span>
          </div>
        </div>

        <div class="strategy-metrics-row">
          <div class="mini-metric">
            <span>Backtest Sharpe</span>
            <strong class="mono">1.84</strong>
          </div>
          <div class="mini-metric">
            <span>Profit Factor</span>
            <strong class="mono">1.62</strong>
          </div>
          <div class="mini-metric">
            <span>Max Drawdown</span>
            <strong class="mono">8.4%</strong>
          </div>
          <div class="mini-metric">
            <span>OOS Pass Rate</span>
            <strong class="mono text-bull">100%</strong>
          </div>
        </div>
      </div>
    </div>

    <!-- Persistent Sidebar: Live Trades Across ALL Tickers & Providers (Section 16.2) -->
    <aside class="sidebar-trades-view">
      <!-- Risk Gate Daily Loss Progress Bar (Section 5.1) -->
      <div class="glass-card risk-card">
        <div class="risk-header">
          <h4>Provider Risk Gate & Daily Loss Limit</h4>
          <span class="mono risk-pct">0.42% / 2.0%</span>
        </div>
        <div class="progress-bar-container">
          <div class="progress-bar-fill" style="width: 21%;"></div>
        </div>
        <p class="risk-sub">Daily Reset: 00:00 UTC | Hard Limit Gate Enforcement Active</p>
      </div>

      <!-- Live Open Positions Sidebar List (Section 16.2) -->
      <div class="glass-card live-positions-card">
        <div class="sidebar-title-row">
          <h3>Live Trades Across All Tickers</h3>
          <span class="pulse-tag"><span class="status-dot"></span> Streaming</span>
        </div>
        <p class="sidebar-hint">Real-time status across Binance & Zerodha accounts</p>

        <div class="positions-list" id="positionsList">
          <!-- Live Trade Entry Item -->
          <div class="position-item">
            <div class="pos-top">
              <div class="pos-symbol">
                <strong class="mono">BTC/USDT</strong>
                <span class="provider-tag">Binance</span>
              </div>
              <span class="badge badge-bull">LONG</span>
            </div>

            <div class="pos-mid">
              <div class="pos-stat">
                <span class="pos-lbl">Entry</span>
                <span class="pos-val mono">$64,850.00</span>
              </div>
              <div class="pos-stat">
                <span class="pos-lbl">Current P/L</span>
                <span class="pos-val mono text-bull">+$390.50 (+0.60%)</span>
              </div>
            </div>

            <div class="pos-bot">
              <span class="pos-time">Open: 2h 14m</span>
              <span class="probation-badge">Probation 25%</span>
            </div>
          </div>

          <!-- Live Trade Entry Item 2 -->
          <div class="position-item">
            <div class="pos-top">
              <div class="pos-symbol">
                <strong class="mono">ETH/USDT</strong>
                <span class="provider-tag">Binance</span>
              </div>
              <span class="badge badge-bull">LONG</span>
            </div>

            <div class="pos-mid">
              <div class="pos-stat">
                <span class="pos-lbl">Entry</span>
                <span class="pos-val mono">$3,380.00</span>
              </div>
              <div class="pos-stat">
                <span class="pos-lbl">Current P/L</span>
                <span class="pos-val mono text-bull">+$42.10 (+1.24%)</span>
              </div>
            </div>

            <div class="pos-bot">
              <span class="pos-time">Open: 45m</span>
              <span class="probation-badge">Full Size</span>
            </div>
          </div>
        </div>
      </div>
    </aside>
  </div>

  <style>
    .dashboard-grid {
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 1.5rem;
    }
    @media (max-width: 1100px) {
      .dashboard-grid {
        grid-template-columns: 1fr;
      }
    }
    .main-ticker-view {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .ticker-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .ticker-selector-container {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .label {
      font-size: 0.85rem;
      color: var(--text-muted);
    }
    .select-input {
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 0.5rem 1rem;
      border-radius: 8px;
      font-family: var(--font-sans);
      font-size: 0.9rem;
      outline: none;
    }
    .select-input:focus {
      border-color: var(--accent-cyan);
    }
    .price-stat-group {
      display: flex;
      gap: 2rem;
    }
    .stat-item {
      display: flex;
      flex-direction: column;
    }
    .stat-label {
      font-size: 0.75rem;
      color: var(--text-muted);
    }
    .stat-value {
      font-weight: 600;
      font-size: 1.1rem;
    }
    .text-bull { color: var(--color-bull); }
    .text-bear { color: var(--color-bear); }

    .chart-card {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .chart-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .chart-title {
      font-size: 1rem;
      font-weight: 600;
    }
    .timeframe-buttons {
      display: flex;
      gap: 0.4rem;
    }
    .timeframe-buttons .btn {
      padding: 0.25rem 0.6rem;
      font-size: 0.75rem;
    }
    .canvas-container {
      width: 100%;
      background: rgba(0, 0, 0, 0.3);
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.04);
      padding: 0.5rem;
      overflow: hidden;
    }
    canvas {
      width: 100%;
      height: 380px;
      display: block;
    }

    .strategy-card {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .strategy-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }
    .card-heading {
      font-size: 1rem;
      font-weight: 600;
    }
    .card-subtext {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: 0.2rem;
    }
    .strategy-details-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      background: rgba(0, 0, 0, 0.25);
      padding: 1rem;
      border-radius: 8px;
    }
    .detail-box {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }
    .detail-label {
      font-size: 0.75rem;
      color: var(--text-muted);
    }
    .detail-val {
      font-weight: 600;
      font-size: 0.95rem;
    }
    .strategy-metrics-row {
      display: flex;
      gap: 1.5rem;
      border-top: 1px solid var(--border-color);
      padding-top: 0.75rem;
    }
    .mini-metric {
      display: flex;
      gap: 0.5rem;
      font-size: 0.825rem;
      color: var(--text-muted);
    }
    .mini-metric strong {
      color: var(--text-main);
    }

    /* Sidebar Styles */
    .sidebar-trades-view {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .risk-card {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      background: rgba(239, 68, 68, 0.05);
      border-color: rgba(239, 68, 68, 0.2);
    }
    .risk-header {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      font-weight: 600;
    }
    .progress-bar-container {
      width: 100%;
      height: 8px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 4px;
      overflow: hidden;
    }
    .progress-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--color-bull), var(--color-warning));
      border-radius: 4px;
    }
    .risk-sub {
      font-size: 0.7rem;
      color: var(--text-dim);
    }

    .live-positions-card {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .sidebar-title-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .sidebar-title-row h3 {
      font-size: 1rem;
      font-weight: 600;
    }
    .pulse-tag {
      font-size: 0.75rem;
      color: var(--color-bull);
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }
    .sidebar-hint {
      font-size: 0.75rem;
      color: var(--text-dim);
      margin-top: -0.5rem;
    }
    .positions-list {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }
    .position-item {
      background: rgba(0, 0, 0, 0.3);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      transition: all 0.2s ease;
    }
    .position-item:hover {
      border-color: var(--accent-cyan);
    }
    .pos-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .pos-symbol {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .provider-tag {
      font-size: 0.65rem;
      background: rgba(255, 255, 255, 0.08);
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
      color: var(--text-muted);
    }
    .pos-mid {
      display: flex;
      justify-content: space-between;
      background: rgba(255, 255, 255, 0.02);
      padding: 0.4rem 0.6rem;
      border-radius: 6px;
    }
    .pos-stat {
      display: flex;
      flex-direction: column;
    }
    .pos-lbl {
      font-size: 0.7rem;
      color: var(--text-dim);
    }
    .pos-val {
      font-size: 0.85rem;
      font-weight: 600;
    }
    .pos-bot {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.7rem;
      color: var(--text-dim);
    }
    .probation-badge {
      color: var(--accent-cyan);
      font-weight: 500;
    }
  </style>

  <script>
    // Real-Time Canvas Candlestick Chart Renderer & Polling Loop
    const canvas = document.getElementById('candlestickCanvas') as HTMLCanvasElement;
    if (canvas) {
      const ctx = canvas.getContext('2d');
      if (ctx) {
        // Draw sample candlestick chart
        const drawChart = () => {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          
          // Draw grid lines
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
          ctx.lineWidth = 1;
          for (let y = 50; y < canvas.height; y += 50) {
            ctx.beginPath();
            ctx.moveTo(0, y);
            ctx.lineTo(canvas.width, y);
            ctx.stroke();
          }

          // Sample candles
          const candleCount = 40;
          const barWidth = 14;
          const gap = 6;
          let basePrice = 200;

          for (let i = 0; i < candleCount; i++) {
            const x = i * (barWidth + gap) + 30;
            const change = (Math.random() - 0.48) * 15;
            const open = basePrice;
            const close = basePrice + change;
            const high = Math.max(open, close) + Math.random() * 8;
            const low = Math.min(open, close) - Math.random() * 8;
            basePrice = close;

            const isBull = close >= open;
            ctx.strokeStyle = isBull ? '#10b981' : '#ef4444';
            ctx.fillStyle = isBull ? '#10b981' : '#ef4444';

            // Wick
            ctx.beginPath();
            ctx.moveTo(x + barWidth / 2, canvas.height - high);
            ctx.lineTo(x + barWidth / 2, canvas.height - low);
            ctx.stroke();

            // Body
            const bodyY = canvas.height - Math.max(open, close);
            const bodyHeight = Math.max(2, Math.abs(close - open));
            ctx.fillRect(x, bodyY, barWidth, bodyHeight);
          }
        };

        drawChart();
        setInterval(drawChart, 3000); // Pulse update every 3s
      }
    }
  </script>
</Layout>
