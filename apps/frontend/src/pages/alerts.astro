---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Alerts — AI Algorithmic Trading Platform">
  <div class="page-container">
    <div class="page-header">
      <div>
        <h1 class="page-title">Notifications & System Alerts</h1>
        <p class="page-subtitle">Tiered alerts feed for risk events, strategy auto-promotions, and system audits.</p>
      </div>
      <div class="filter-tabs" id="filterTabs">
        <button class="btn btn-outline active" data-severity="">All Alerts</button>
        <button class="btn btn-outline" data-severity="critical">Critical</button>
        <button class="btn btn-outline" data-severity="warning">Warning</button>
        <button class="btn btn-outline" data-severity="info">Info</button>
      </div>
    </div>

    <div id="alertsError" class="error-text" hidden></div>

    <!-- Alerts Feed List (rendered client-side from GET /alerts) -->
    <div class="alerts-feed" id="alertsFeed">
      <div class="glass-card empty-state">
        <span class="spinner"></span>
        <p>Loading alerts…</p>
      </div>
    </div>
  </div>

  <style>
    .page-container {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .page-title {
      font-size: 1.5rem;
      font-weight: 700;
    }
    .page-subtitle {
      font-size: 0.875rem;
      color: var(--text-muted);
      margin-top: 0.2rem;
    }
    .filter-tabs {
      display: flex;
      gap: 0.5rem;
    }
    .filter-tabs .btn {
      padding: 0.35rem 0.8rem;
      font-size: 0.8rem;
    }

    .alerts-feed {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .alert-item {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      border-left: 4px solid var(--border-color);
    }
    .alert-item.critical {
      border-left-color: var(--color-bear);
      background: rgba(239, 68, 68, 0.05);
    }
    .alert-item.warning {
      border-left-color: var(--color-warning);
      background: rgba(245, 158, 11, 0.05);
    }
    .alert-item.info {
      border-left-color: var(--color-bull);
      background: rgba(16, 185, 129, 0.05);
    }
    .alert-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .alert-time {
      font-size: 0.75rem;
      color: var(--text-dim);
    }
    .alert-title {
      font-size: 0.95rem;
      font-weight: 600;
      text-transform: capitalize;
    }
    .alert-msg {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-top: 0.2rem;
    }
    .alert-bottom {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 0.75rem;
    }
    .ack-tag {
      font-size: 0.75rem;
      color: var(--text-dim);
    }
    .ack-btn {
      padding: 0.3rem 0.75rem;
      font-size: 0.75rem;
    }
  </style>

  <script>
    import { apiGet, apiPatch, requireAuth, ApiError } from '../lib/api';
    import { onAlertCreated } from '../lib/ws';

    requireAuth();

    type Alert = {
      id: string;
      severity: 'critical' | 'warning' | 'info';
      category: string;
      message: string;
      relatedEntityType?: string;
      relatedEntityId?: string;
      createdAt: string;
      acknowledgedAt?: string | null;
    };

    const feed = document.getElementById('alertsFeed')!;
    const errorBanner = document.getElementById('alertsError')!;
    const tabs = document.querySelectorAll<HTMLButtonElement>('#filterTabs button');

    let currentSeverity = '';
    let alerts: Alert[] = [];

    function badgeClass(severity: string): string {
      if (severity === 'critical') return 'badge-bear';
      if (severity === 'warning') return 'badge-info';
      return 'badge-bull';
    }

    function formatTime(iso: string): string {
      if (!iso) return '';
      const d = new Date(iso);
      if (Number.isNaN(d.getTime())) return iso;
      return d.toLocaleString(undefined, {
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });
    }

    function renderAlert(a: Alert): string {
      const title = (a.category || 'alert').replace(/[_-]/g, ' ');
      return `
        <div class="glass-card alert-item ${a.severity}" data-alert-id="${a.id}">
          <div class="alert-top">
            <span class="badge ${badgeClass(a.severity)}">${a.severity.toUpperCase()}</span>
            <span class="alert-time mono">${formatTime(a.createdAt)}</span>
          </div>
          <div class="alert-content">
            <h4 class="alert-title">${escapeHtml(title)}</h4>
            <p class="alert-msg">${escapeHtml(a.message)}</p>
          </div>
          <div class="alert-bottom">
            ${
              a.acknowledgedAt
                ? `<span class="ack-tag">Acknowledged ${formatTime(a.acknowledgedAt)}</span>`
                : `<button class="btn btn-outline ack-btn">Acknowledge</button>`
            }
          </div>
        </div>
      `;
    }

    function escapeHtml(s: string): string {
      const div = document.createElement('div');
      div.textContent = s ?? '';
      return div.innerHTML;
    }

    function render() {
      if (!alerts.length) {
        feed.innerHTML = `
          <div class="glass-card empty-state">
            <p>No ${currentSeverity ? currentSeverity + '-tier ' : ''}alerts yet. This feed updates live as the system generates them.</p>
          </div>
        `;
        return;
      }
      feed.innerHTML = alerts.map(renderAlert).join('');
      attachAckListeners();
    }

    function attachAckListeners() {
      feed.querySelectorAll<HTMLElement>('.alert-item[data-alert-id]').forEach((card) => {
        const id = card.dataset.alertId!;
        const btn = card.querySelector<HTMLButtonElement>('.ack-btn');
        btn?.addEventListener('click', async () => {
          btn.disabled = true;
          btn.innerHTML = '<span class="spinner"></span>';
          try {
            await apiPatch(`/alerts/${id}/ack`);
            const alert = alerts.find((a) => a.id === id);
            if (alert) alert.acknowledgedAt = new Date().toISOString();
            render();
          } catch (err) {
            errorBanner.hidden = false;
            errorBanner.textContent = err instanceof ApiError ? err.message : 'Failed to acknowledge alert';
            btn.disabled = false;
            btn.textContent = 'Acknowledge';
          }
        });
      });
    }

    async function loadAlerts() {
      errorBanner.hidden = true;
      feed.innerHTML = `<div class="glass-card empty-state"><span class="spinner"></span><p>Loading alerts…</p></div>`;
      try {
        const query = currentSeverity ? `?severity=${currentSeverity}` : '';
        alerts = await apiGet<Alert[]>(`/alerts${query}`);
        render();
      } catch (err) {
        errorBanner.hidden = false;
        errorBanner.textContent = err instanceof ApiError ? err.message : 'Failed to load alerts';
        feed.innerHTML = '';
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        currentSeverity = tab.dataset.severity || '';
        loadAlerts();
      });
    });

    // Live updates: new alerts pushed from the server get prepended if they match the active filter.
    onAlertCreated((alert: Alert) => {
      if (currentSeverity && alert.severity !== currentSeverity) return;
      if (alerts.some((a) => a.id === alert.id)) return;
      alerts = [alert, ...alerts];
      render();
    });

    loadAlerts();
  </script>
</Layout>
