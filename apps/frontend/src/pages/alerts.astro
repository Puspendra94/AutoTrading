---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Alerts — AI Algorithmic Trading Platform">
  <div class="page-container">
    <div class="page-header">
      <div>
        <h1 class="page-title">Notifications & System Alerts</h1>
        <p class="page-subtitle">Tiered alerts feed for risk events, strategy auto-promotions, and system audits.</p>
      </div>
      <div class="filter-tabs">
        <button class="btn btn-outline active">All Alerts</button>
        <button class="btn btn-outline">Critical</button>
        <button class="btn btn-outline">Warning</button>
        <button class="btn btn-outline">Info</button>
      </div>
    </div>

    <!-- Alerts Feed List -->
    <div class="alerts-feed">
      <!-- Critical Tier Alert -->
      <div class="glass-card alert-item critical">
        <div class="alert-top">
          <span class="badge badge-bear">CRITICAL</span>
          <span class="alert-time mono">Today at 13:05 UTC</span>
        </div>
        <div class="alert-content">
          <h4 class="alert-title">Risk Gate Daily Loss Limit Verification Passed</h4>
          <p class="alert-msg">Provider Binance daily loss tracking initialized at 0.42% (well within 2.0% cap). Hard risk gate enforcement active on all order submissions.</p>
        </div>
      </div>

      <!-- Info Tier Alert -->
      <div class="glass-card alert-item info">
        <div class="alert-top">
          <span class="badge badge-bull">INFO</span>
          <span class="alert-time mono">Today at 12:45 UTC</span>
        </div>
        <div class="alert-content">
          <h4 class="alert-title">Strategy Auto-Promoted to Live Trading</h4>
          <p class="alert-msg">Ticker BTCUSDT strategy v2 cleared all evaluation criteria (Sharpe 1.84, Profit Factor 1.62). Auto-promoted at probation position size (25%).</p>
        </div>
      </div>

      <!-- Info Tier Alert 2 -->
      <div class="glass-card alert-item info">
        <div class="alert-top">
          <span class="badge badge-bull">INFO</span>
          <span class="alert-time mono">Today at 12:30 UTC</span>
        </div>
        <div class="alert-content">
          <h4 class="alert-title">Ticker Onboarding Completed</h4>
          <p class="alert-msg">Ticker BTCUSDT completed historical OHLCV backfill (500 candles), data quality audit clean, strategy generation complete.</p>
        </div>
      </div>
    </div>
  </div>

  <style>
    .page-container {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .page-title {
      font-size: 1.5rem;
      font-weight: 700;
    }
    .page-subtitle {
      font-size: 0.875rem;
      color: var(--text-muted);
      margin-top: 0.2rem;
    }
    .filter-tabs {
      display: flex;
      gap: 0.5rem;
    }
    .filter-tabs .btn {
      padding: 0.35rem 0.8rem;
      font-size: 0.8rem;
    }

    .alerts-feed {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .alert-item {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      border-left: 4px solid var(--border-color);
    }
    .alert-item.critical {
      border-left-color: var(--color-bear);
      background: rgba(239, 68, 68, 0.05);
    }
    .alert-item.info {
      border-left-color: var(--color-bull);
      background: rgba(16, 185, 129, 0.05);
    }
    .alert-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .alert-time {
      font-size: 0.75rem;
      color: var(--text-dim);
    }
    .alert-title {
      font-size: 0.95rem;
      font-weight: 600;
    }
    .alert-msg {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-top: 0.2rem;
    }
  </style>
</Layout>
